# =============================================================================
# .gitignore — skill-create-gitignore (+ skill-commit-check)
# Product: AgentCli (specialized software-dev; Python package, console agent-cli)
# Docs: track docs/requirements/** ; ignore skills/incidents/terminologies/policies/templates
# Track: README, CHANGELOG, LICENSE, SECURITY, src/, tests/, reviews/
# Artifacts: universal compiled/temp/secrets/caches; shell run debris
# =============================================================================

# --- Secrets / local env ---
.env
.env.*
!.env.example
!.env.sample
*.pem

# --- OS ---
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editors / IDEs ---
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# --- Temp / scratch / logs ---
tmp/
temp/
temps/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
logs/
*.pid
*.seed

# --- Generic compiled / package outputs (defense in depth) ---
build/
dist/
out/
output/
obj/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.war
*.ear
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
*.whl
*.rlib
*.rmeta

# --- Caches ---
.cache/
*.cache
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Shell / local run debris ---
*.YYYYMMDD-*.bak

# --- Harness transfer safety backups (H1/H2; not payload) ---
.harness-transfer-bak-*/
.harness-sync-*-bak-*/
.harness-*-bak-*/
.harness-backup-*/

# --- Agent contract (local workspace) ---
AGENTS.md

# --- Local harness backup dumps (never product surface) ---
.h1-backup-*/
.h2-backup-*/

# --- Docs layer: ignore all docs, re-include requirements only ---
# Includes docs/policies/ (policy-*.md), skills, terminologies, templates, etc.
# Policies must NOT be public product surface.
docs/**
!docs/requirements/
!docs/requirements/**

# --- Public product reviews (git-tracked when present) ---
# reviews/ is at product root (not under docs/); keep tracked by default (no ignore)
