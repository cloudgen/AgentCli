    out_plain "  ZSHENV              zsh always-on rc write path (default ~/.zshenv; tests retarget)"
    out_plain "  ZSHRC / PROFILE / FISH_CONFIG  other rc write paths (tests retarget; zsh PATH is ZSHENV)"
    out_plain "  GROK_CLI_ARGV0      invoking name for ash detect (default \$0; -ash / ash)"
    out_plain "  GROK_CLI_ALPINE_RELEASE  alpine-release file (default /etc/alpine-release; sh on Alpine is ash)"
    out_plain "  ALLOW_TEST_LOCAL_SUDOERS  1 = allow test-mode print-sudoers / generate / submit"
    out_plain "  SUDOER_CLI              override path to sudoer-cli"
    out_plain "  SUDOER_ADM_USER         approver login (default sudoer-adm)"
    out_plain "  SUDOER_QUEUE_INBOUND    override inbound approval dir"
    out_plain "  SUDOER_PUBLIC_ROOT      public queue root (default /var/sudoer-cli)"
    out_plain "  SUDOERS_D_DIR           host sudoers.d dir (default /etc/sudoers.d; tests)"
    out_empty_line
    out_info "Examples:"
    out_plain "  ${APP_NAME}                    # numbered list on a TTY; help off-TTY"
    out_plain "  curl -fsSL https://raw.githubusercontent.com/cloudgen/grok-cli/main/src/grok-cli | sh"
    out_plain "  ${APP_NAME} install"
    out_plain "  ${APP_NAME} setup                 # install grok from x.ai channel + artifact (not ${APP_NAME})"
