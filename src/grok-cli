# =============================================================================
# gc_host_is_termux() / gc_host_is_git_bash() / gc_host_is_windows_cmd()
# gc_host_is_normal_user_only() / gc_host_normal_user_only_label()
# =============================================================================
#
# GENERAL PURPOSE:
# Detect command-line-for-normal-user-only hosts (this login only: Termux,
# Git Bash, Windows cmd). Label is termux / gitbash / windows-cmd for the
# main-menu not-available line.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-interface.md
#
# Last updated: 2026-09-07
# GROK_CLI_HOST_OVERRIDE=multiuser lets Core tests on Android keep the
# multi-user menu (TERMUX_VERSION still wins for Termux cases).
# =============================================================================
gc_host_is_termux() {
    if [ -n "${TERMUX_VERSION:-}" ]; then
        return 0
    fi
    case "${GROK_CLI_HOST_OVERRIDE:-}" in
        multiuser|gitbash|windows-cmd)
            return 1
            ;;
        termux)
            return 0
            ;;
    esac
    if [ -n "${PREFIX:-}" ]; then
        return 0
    fi
    gc_setup_host_is_android
}

gc_host_is_git_bash() {
    if [ -n "${MSYSTEM:-}" ]; then
        return 0
    fi
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*) return 0 ;;
    esac
    return 1
}

gc_host_is_windows_cmd() {
    if [ "${OS:-}" != "Windows_NT" ]; then
        return 1
    fi
    if gc_host_is_git_bash; then
        return 1
    fi
    case "$(uname -s 2>/dev/null)" in
        CYGWIN*|MINGW*|MSYS*) return 1 ;;
    esac
    if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ]; then
        return 1
    fi
    case "$(uname -r 2>/dev/null)" in
        *[Mm]icrosoft*) return 1 ;;
    esac
    return 0
}

gc_host_is_normal_user_only() {
    if gc_host_is_termux; then
        return 0
    fi
    if gc_host_is_git_bash; then
        return 0
    fi
    gc_host_is_windows_cmd
}

gc_host_normal_user_only_label() {
    if gc_host_is_termux; then
        printf '%s' "termux"
        return 0
    fi
    if gc_host_is_git_bash; then
        printf '%s' "gitbash"
        return 0
    fi
    if gc_host_is_windows_cmd; then
        printf '%s' "windows-cmd"
        return 0
    fi
    printf '%s' ""
}

# =============================================================================
# app_lang_load() / app_lang_save() / app_menu_text()
# =============================================================================
#
# GENERAL PURPOSE:
# Menu language for the numbered list, human help, and human about.
# Codes: en, zh-Hans, zh-Hant, es, ar, fr, pt, ru, de, ja, ko, nl, el.
# The leaf is ${PERSISTENT_STORAGE_DIR}/language (mode 0600).
# GROK_CLI_LANG wins at process start and does not write the file.
# One load at the start of app_main. A later pick sets APP_LANG itself.
# Leaf shorts stay the English verb. Category shorts follow APP_LANG.
# app_menu_text is pure data: no read builtin. Command substitution is legal.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-10-02
# =============================================================================
app_lang_load() {
    APP_LANG=en
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ll_path="${PERSISTENT_STORAGE_DIR}/language"
    if [ -f "${_ll_path}" ]; then
        _ll_line=$(head -n 1 "${_ll_path}" 2>/dev/null || true)
        _ll_line=$(printf '%s' "${_ll_line}" | tr -d '\r')
        case "${_ll_line}" in
            en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) APP_LANG="${_ll_line}" ;;
        esac
    fi
    case "${GROK_CLI_LANG-}" in
        en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) APP_LANG="${GROK_CLI_LANG}" ;;
    esac
    export APP_LANG
    unset _ll_path _ll_line
}

app_lang_save() {
    _ls_code=${1-}
    case "${_ls_code}" in
        en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) ;;
        *)
            unset _ls_code
            return 1
            ;;
    esac
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ls_path="${PERSISTENT_STORAGE_DIR}/language"
    if ! printf '%s\n' "${_ls_code}" > "${_ls_path}"; then
        unset _ls_code _ls_path
        return 1
    fi
    chmod 0600 "${_ls_path}" 2>/dev/null || true
    APP_LANG="${_ls_code}"
    export APP_LANG
    unset _ls_code _ls_path
    return 0
}

