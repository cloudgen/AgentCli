# gc_menu_auth_rows() - grok-auth submenu "NUMBER TOKEN" (fixed 11-16)
# =============================================================================
#
# 11 backup when logged in on a multi-user host (push ~/.grok/auth.* to the
# global store). Hide 11 when logged out, on timeout, and on this-login-only.
# 12 sync-auth-from-remote when not logged in.
# 13 sync-auth when not logged in on a multi-user host (copy the global store
# into ~/.grok). Hide 13 when logged in and on this-login-only.
# sync-auth-to-remote is a typed command, not a row.
# Numbers 14-16 do not slide. 17 is not a row.
# =============================================================================
gc_menu_auth_rows() {
    if ! gc_host_is_normal_user_only; then
        if [ "${GC_SESSION_STATUS_CACHE-}" = "valid" ]; then
            printf '%s\n' "11 backup"
        fi
    fi
    if [ "${GC_SESSION_STATUS_CACHE-}" != "valid" ]; then
        printf '%s\n' "12 sync-auth-from-remote"
    fi
    if ! gc_host_is_normal_user_only; then
        if [ "${GC_SESSION_STATUS_CACHE-}" != "valid" ]; then
            printf '%s\n' "13 sync-auth"
        fi
    fi
    printf '%s\n' "14 add-crontab"
    printf '%s\n' "15 setup"
    printf '%s\n' "16 reinstall"
