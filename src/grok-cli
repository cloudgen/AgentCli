    out_plain "  GROK_CHANNEL            grok channel (stable|alpha|enterprise; default stable)"
    out_plain "  GROK_SETUP_VERSION      pin grok version (skip channel pointer)"
    out_plain "  GROK_BIN             override path to peer grok"
    out_plain "  GROK_PROMPT_TIMEOUT  seconds for grok -p hello (default 14; always bounded)"
    out_plain "  GROK_PROMPT_KILL_AFTER  SIGKILL grace after the probe deadline (default 2)"
    out_plain "  USER_BIN / GLOBAL_BIN  install destinations"
