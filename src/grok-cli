# appended logged-in not-available when session is valid, then remaining
# listed rows, then Exit 9. The top list has no Back row. Session status
# is under the title (not a row): logged in / timeout / logged out. Host
# not-available is never replaced by the logged-in line. Reuse
# GC_SESSION_STATUS_CACHE on reprint so a bad pick does not run grok -p
# hello again. PRoot/Termux uses local auth cookies (no live probe). On
# other hosts, print a checking-session line before the live probe.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-internal-volatile-timer.md
#
# Last updated: 2026-09-26
# =============================================================================
app_default_print_menu() {
    : "${APP_NAME:=grok-cli}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Alternative online installer for xAI grok}}"

    util_int_timer_debug_begin "paint"

    util_int_timer_debug_begin "header"
    if gc_menu_lang_is_en; then
        out_info "$(util_app_ident) — ${SHORT_DESCRIPTION}"
    else
        out_info "$(util_app_ident) — $(app_menu_text short_desc)"
    fi
    util_int_timer_debug_end "header"

    util_int_timer_debug_begin "session"
    if [ -n "${GC_SESSION_STATUS_CACHE:-}" ]; then
        _st="${GC_SESSION_STATUS_CACHE}"
    else
        if ! gc_session_uses_local_auth; then
            : "${GROK_PROMPT_TIMEOUT:=14}"
            _gpt_show=$(gc_grok_prompt_int "${GROK_PROMPT_TIMEOUT}" 14)
            if gc_menu_lang_is_en; then
                out_info "checking session (grok -p hello, timeout ${_gpt_show}s)..."
            else
                out_info "$(app_menu_text session_checking "${_gpt_show}")"
            fi
            unset _gpt_show
        fi
        _st=$(gc_session_status_word) || true
        GC_SESSION_STATUS_CACHE="${_st}"
        export GC_SESSION_STATUS_CACHE
    fi
    if [ "${_st}" = "valid" ]; then
        if gc_menu_lang_is_en; then
            out_info "logged in"
        else
            out_info "$(app_menu_text session_in)"
        fi
    elif [ "${_st}" = "timeout" ]; then
        if gc_menu_lang_is_en; then
            out_info "timeout"
        else
            out_info "$(app_menu_text session_timeout)"
        fi
    else
        if gc_menu_lang_is_en; then
            out_info "logged out"
        else
            out_info "$(app_menu_text session_out)"
        fi
    fi
    util_int_timer_debug_end "session"

    util_int_timer_debug_begin "host"
    gc_menu_print_host_hide
    util_int_timer_debug_end "host"

    util_int_timer_debug_begin "logged-in"
    if [ "${_st}" = "valid" ]; then
        gc_menu_print_login_hide
    else
        gc_menu_print_logout_hide
    fi
    util_int_timer_debug_end "logged-in"

    util_int_timer_debug_begin "rows"
    while read -r _n _tok; do
        [ -n "${_n}" ] || continue
        out_menu_choice "${_n}" "$(gc_menu_short "${_tok}")" "$(gc_menu_row_explain "${_tok}")"
    done <<EOF
$(gc_menu_main_rows)
EOF
    gc_menu_print_exit
    util_int_timer_debug_end "rows"

    util_int_timer_debug_end "paint"
}

