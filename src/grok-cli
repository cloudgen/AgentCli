# =============================================================================
# gc_menu_pick_is_family() - 0 when the top-list pick is that family token
# =============================================================================
gc_menu_pick_is_family() {
    _fam="${1-}"
    _want="${2-}"
    _listed=$(gc_menu_main_rows | gc_menu_row_match "${_fam}" || true)
    if [ "${_listed}" != "${_fam}" ]; then
        unset _fam _want _listed
        return 1
    fi
    if gc_menu_family_alias "${_fam}" "${_want}"; then
        unset _fam _want _listed
        return 0
    fi
    _hit=$(gc_menu_main_rows | gc_menu_row_match "${_want}" || true)
    if [ "${_hit}" = "${_fam}" ]; then
        unset _fam _want _listed _hit
        return 0
    fi
    unset _fam _want _listed _hit
    return 1
}

# =============================================================================
# app_default_print_menu() - Numbered main-menu list (TTY)
# =============================================================================
#
# GENERAL PURPOSE:
# Print the grok-cli daily-work list: APP_NAME(APP_VERSION) header plus
