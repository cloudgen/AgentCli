# app_default_run_pick() - Run one main-menu choice (number or verb)
# =============================================================================
#
# GENERAL PURPOSE:
# Map a main-list pick to a live handler using the same visible-token list
# as the printer. Family row sudoers is not handled here (caller opens the
# submenu). Returns 1 if the pick is not on the list. Returns 0 after a
# run or Exit. Hidden rows (host or logged-in) MUST NOT run from a number.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-26
# =============================================================================
app_default_run_pick() {
    _pick="${1:-}"

    case "${_pick}" in
        9|99|exit|quit|Exit|QUIT)
            return 0
            ;;
    esac

    _run=$(gc_menu_main_rows | gc_menu_row_match "${_pick}" || true)
    case "${_run}" in
        run)
            gc_run_grok
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

