inst_ensure_companion() {
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _iec_target=$(util_get_install_bin_path 2>/dev/null || printf '%s/%s' "${USER_BIN}" "${APP_NAME}")
