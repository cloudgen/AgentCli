        *Android*) return 0 ;;
    esac
    return 1
}

# =============================================================================
# gc_setup_termux_exec_off() - unset Termux LD_PRELOAD for one exec
# =============================================================================
#
# GENERAL PURPOSE:
# termux-exec (LD_PRELOAD) rewrites execve through linker64, which
# refuses ET_EXEC. Save and clear it; pair with gc_setup_termux_exec_restore.
# Also used before proot (Termux wiki: proot under libtermux-exec fails).
#
# ALIGNMENT: requirement-grok-setup.md · requirement-shell-termux-coding.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_termux_exec_off() {
    GC_SETUP_LD_SET=0
    if [ "${LD_PRELOAD+x}" = "x" ]; then
        GC_SETUP_LD_SET=1
        GC_SETUP_LD="${LD_PRELOAD}"
    fi
    GC_SETUP_OPT_SET=0
    if [ "${TERMUX_EXEC_OPTOUT+x}" = "x" ]; then
        GC_SETUP_OPT_SET=1
        GC_SETUP_OPT="${TERMUX_EXEC_OPTOUT}"
    fi
    unset LD_PRELOAD
    TERMUX_EXEC_OPTOUT=1
    export TERMUX_EXEC_OPTOUT
    return 0
}

# =============================================================================
# gc_setup_termux_exec_restore() - restore LD_PRELOAD after a smoke exec
# =============================================================================
gc_setup_termux_exec_restore() {
    if [ "${GC_SETUP_LD_SET:-0}" -eq 1 ]; then
        LD_PRELOAD="${GC_SETUP_LD}"
        export LD_PRELOAD
    fi
    if [ "${GC_SETUP_OPT_SET:-0}" -eq 1 ]; then
        TERMUX_EXEC_OPTOUT="${GC_SETUP_OPT}"
        export TERMUX_EXEC_OPTOUT
    else
        unset TERMUX_EXEC_OPTOUT
    fi
    return 0
}

# =============================================================================
# gc_setup_keep_failed_download() - leave smoked file as grok-*.failed
# =============================================================================
#
# GENERAL PURPOSE:
# On Android ET_EXEC refusal, do not rm the mktemp sibling. Rename it
# to downloads/grok-{{os}}-{{arch}}.failed so ls ~/.grok/downloads shows it.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_keep_failed_download() {
    _gkf_src="${1:-}"
    _gkf_dir="${2:-}"
    _gkf_plat="${3:-}"
    GC_SETUP_FAILED_PATH=""
    if [ -z "${_gkf_src}" ] || [ ! -f "${_gkf_src}" ] || [ -z "${_gkf_dir}" ] || [ -z "${_gkf_plat}" ]; then
        return 1
    fi
    _gkf_dest="${_gkf_dir}/grok-${_gkf_plat}.failed"
    mv -f "${_gkf_src}" "${_gkf_dest}" || return 1
    chmod 0755 "${_gkf_dest}" 2>/dev/null || true
    GC_SETUP_FAILED_PATH="${_gkf_dest}"
    unset _gkf_src _gkf_dir _gkf_plat _gkf_dest
    return 0
}

# =============================================================================
# gc_setup_smoke_version() - exec downloaded grok --version (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Smoke the artifact in place. On failure, set GC_SETUP_SMOKE_DETAIL to a
# short "exit N: stderr" line for the operator error. Cache/tmp may be
# noexec; the caller MUST pass a path under GROK_HOME/downloads.
# $2 = direct (default) | optout | proot. optout unsets LD_PRELOAD and
# sets TERMUX_EXEC_OPTOUT so Termux does not load ET_EXEC via linker64.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_smoke_version() {
    _gsv_bin="${1:-}"
    _gsv_how="${2:-direct}"
    GC_SETUP_SMOKE_DETAIL=""
    if [ -z "${_gsv_bin}" ] || [ ! -f "${_gsv_bin}" ]; then
        GC_SETUP_SMOKE_DETAIL="file missing"
        return 1
    fi
    _gsv_out=$(util_mktemp smokeout)
    if [ -z "${_gsv_out}" ]; then
        GC_SETUP_SMOKE_DETAIL="could not capture smoke output"
        return 1
    fi
    _gsv_ec=1
    case "${_gsv_how}" in
        optout)
            gc_setup_termux_exec_off
            "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            gc_setup_termux_exec_restore
            ;;
        proot)
            _gsv_proot=$(command -v proot 2>/dev/null || true)
            if [ -z "${_gsv_proot}" ]; then
                rm -f "${_gsv_out}"
                GC_SETUP_SMOKE_DETAIL="proot not on PATH"
                unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_proot
                return 1
            fi
            gc_setup_termux_exec_off
            "${_gsv_proot}" "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            gc_setup_termux_exec_restore
            ;;
        *)
            "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            ;;
    esac
    if [ "${_gsv_ec}" -eq 0 ]; then
        rm -f "${_gsv_out}"
        unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_ld_set _gsv_ld _gsv_opt_set _gsv_opt _gsv_proot
        return 0
    fi
    _gsv_txt=$(tr '\n' ' ' < "${_gsv_out}" 2>/dev/null | cut -c1-200)
    rm -f "${_gsv_out}"
    GC_SETUP_SMOKE_DETAIL="exit ${_gsv_ec}"
    if [ -n "${_gsv_txt}" ]; then
        GC_SETUP_SMOKE_DETAIL="${GC_SETUP_SMOKE_DETAIL}: ${_gsv_txt}"
    fi
    unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_txt _gsv_ld_set _gsv_ld _gsv_opt_set _gsv_opt _gsv_proot
    return 1
}

# =============================================================================
# gc_setup_ensure_termux_proot() - Type 0: pkg install -y proot on Termux
# =============================================================================
#
# GENERAL PURPOSE:
# When Android/Termux cannot exec the vendor grok and proot is missing,
# install it with Termux pkg (no sudo, -y, stdin closed). MUST NOT run
# pkg on non-Android (FreeBSD pkg is a different tool). A failed install
# is not a setup fatal — caller retries smoke and uses the e_type Next.
#
# ALIGNMENT: requirement-grok-setup.md · requirement-shell-termux-coding.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_ensure_termux_proot() {
    : "${APP_NAME:=grok-cli}"
    if command -v proot >/dev/null 2>&1; then
        return 0
    fi
    if ! gc_setup_host_is_android; then
        return 1
    fi
    _gep_pkg=""
    if [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/pkg" ]; then
        _gep_pkg="${PREFIX}/bin/pkg"
    else
        _gep_pkg=$(command -v pkg 2>/dev/null || true)
    fi
    if [ -z "${_gep_pkg}" ]; then
        unset _gep_pkg
        return 1
    fi
    out_info "This Termux host needs proot to run grok. Installing proot with pkg install -y proot."
    _gep_df_set=0
    if [ "${DEBIAN_FRONTEND+x}" = "x" ]; then
        _gep_df_set=1
        _gep_df="${DEBIAN_FRONTEND}"
    fi
    DEBIAN_FRONTEND=noninteractive
    export DEBIAN_FRONTEND
    _gep_pkg_out=$(util_mktemp pkgout)
    "${_gep_pkg}" install -y proot </dev/null >"${_gep_pkg_out}" 2>&1
    _gep_pkg_ec=$?
    if [ "${_gep_pkg_ec}" -ne 0 ]; then
        _gep_snip=$(tr '\n' ' ' < "${_gep_pkg_out}" 2>/dev/null | cut -c1-200)
        rm -f "${_gep_pkg_out}"
        if [ -n "${_gep_snip}" ]; then
            out_warn "pkg install -y proot failed (exit ${_gep_pkg_ec}: ${_gep_snip}). Continuing without a new proot."
        else
            out_warn "pkg install -y proot failed (exit ${_gep_pkg_ec}). Continuing without a new proot."
        fi
    else
        rm -f "${_gep_pkg_out}"
    fi
    if [ "${_gep_df_set}" -eq 1 ]; then
        DEBIAN_FRONTEND="${_gep_df}"
        export DEBIAN_FRONTEND
    else
        unset DEBIAN_FRONTEND
    fi
    if [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/proot" ]; then
        case ":${PATH}:" in
            *":${PREFIX}/bin:"*) ;;
            *)
                PATH="${PREFIX}/bin:${PATH}"
                export PATH
                ;;
        esac
    fi
    unset _gep_pkg _gep_df_set _gep_df
    if command -v proot >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_setup_smoke_android() - retry --version via Termux opt-out or proot
# =============================================================================
#
# GENERAL PURPOSE:
# Direct exec of xAI's linux-aarch64 grok fails on many Termux hosts
# (Android linker64: unexpected e_type 2 / ET_EXEC). Retry without
# libtermux-exec; if that fails and proot is missing, pkg install -y
# proot on Termux, then smoke via proot. Sets GC_SETUP_SMOKE_METHOD
# on success. MUST NOT byte-patch the vendor file.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_smoke_android() {
    _gsa_bin="${1:-}"
    GC_SETUP_SMOKE_METHOD=""
    if gc_setup_smoke_version "${_gsa_bin}" optout; then
        GC_SETUP_SMOKE_METHOD="optout"
        unset _gsa_bin
        return 0
    fi
    if ! command -v proot >/dev/null 2>&1; then
        gc_setup_ensure_termux_proot
    fi
    if command -v proot >/dev/null 2>&1; then
        if gc_setup_smoke_version "${_gsa_bin}" proot; then
            GC_SETUP_SMOKE_METHOD="proot"
            unset _gsa_bin
            return 0
        fi
    fi
    unset _gsa_bin
    return 1
}

# =============================================================================
# gc_setup_write_exec_wrapper() - POSIX launcher for Android ET_EXEC grok
# =============================================================================
#
# GENERAL PURPOSE:
# Write bin/grok as a small /bin/sh wrapper that execs the unmodified
# vendor file with TERMUX_EXEC_OPTOUT or proot. Absolute vendor path so
# ~/.local/bin/grok → ~/.grok/bin/grok still finds downloads/.
# proot wrappers pass --kill-on-exit when advertised (never -k:
# that is --kernel-release). Headless -p/--single injects
# --no-auto-update and SIGKILLs the child on Ctrl-C so grok -p
# returns to the shell (vendor grok under proot often prints then
# ignores SIGINT; Ctrl-Z is not an acceptable close). Interactive
# grok still execs so the TUI owns the TTY.
#
# $1 = wrapper path; $2 = vendor file; $3 = optout | proot
# $4 = optional resolv.conf to bind at /etc/resolv.conf via proot -b
#
# ALIGNMENT: requirement-grok-setup.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-07: grok -p hello on Termux printed the answer then hung
# until Ctrl-Z. grok-cli menu was already bounded (1.8.14); the
# operator-facing wrapper still exec'd proot without --kill-on-exit
# and did not SIGKILL on INT. INC-20260907-002.
# 2026-09-07: do not setsid the proot child — on this Android host
# `setsid proot` fails with Permission denied and grok -p exits 1
# with no answer. Detach the reaper with trap '' TSTP instead.
#
# Last updated: 2026-09-07
# =============================================================================
gc_setup_write_exec_wrapper() {
    _gew_path="${1:-}"
    _gew_vendor="${2:-}"
    _gew_method="${3:-optout}"
    _gew_resolv="${4:-}"
    if [ -z "${_gew_path}" ] || [ -z "${_gew_vendor}" ]; then
        return 1
    fi
    case "${_gew_vendor}" in
        *"'"*)
            if ! command -v sed >/dev/null 2>&1; then
                unset _gew_path _gew_vendor _gew_method
                return 1
            fi
            _gew_q="'$(printf '%s' "${_gew_vendor}" | sed "s/'/'\\\\''/g")'"
            ;;
        *)
            _gew_q="'${_gew_vendor}'"
            ;;
    esac
    if [ "${_gew_method}" = "proot" ]; then
        _gew_bind=""
        if [ -n "${_gew_resolv}" ]; then
            case "${_gew_resolv}" in
                *"'"*)
                    if command -v sed >/dev/null 2>&1; then
                        _gew_rq="'$(printf '%s' "${_gew_resolv}" | sed "s/'/'\\\\''/g")'"
                    else
                        _gew_rq="'${_gew_resolv}'"
                    fi
                    ;;
                *)
                    _gew_rq="'${_gew_resolv}'"
                    ;;
            esac
            _gew_bind="-b ${_gew_rq}:/etc/resolv.conf "
        fi
        cat > "${_gew_path}" <<EOF
#!/bin/sh
unset LD_PRELOAD
TERMUX_EXEC_OPTOUT=1
export TERMUX_EXEC_OPTOUT
_g=${_gew_q}
_p=\$(command -v proot 2>/dev/null || true)
if [ -z "\${_p}" ]; then
  printf '%s\\n' "proot is not on PATH, so grok cannot run on this Android host. Next: pkg install proot" >&2
  exit 127
fi
_k=""
if command -v grep >/dev/null 2>&1; then
  if "\${_p}" --help 2>&1 | grep -q kill-on-exit; then
    _k="--kill-on-exit"
  fi
fi
# Login bash under this PRoot sources profile.d/start-services.sh,
# which start-stop-daemon -b runsvdir. Those daemons stay tracees
# after grok-linux exits (wait4 -1 __WALL). Bind a no-op; do not
# edit Termux's file. PREFIX is Termux's prefix when set.
_svc=""
if [ -n "\${PREFIX:-}" ] && [ -f "\${PREFIX}/etc/profile.d/start-services.sh" ]; then
  _svc="-b /dev/null:\${PREFIX}/etc/profile.d/start-services.sh"
fi
_pflag=0
_nau=""
for _a in "\$@"; do
  case "\${_a}" in
    -p|--single|--prompt-file|--prompt-json) _pflag=1 ;;
    --no-auto-update) _nau="have" ;;
  esac
done
if [ "\${_pflag}" -eq 1 ] && [ "\${_nau}" != "have" ]; then
  _nau="--no-auto-update"
else
  _nau=""
fi
if [ "\${_pflag}" -eq 1 ]; then
  # grok-cli proot-exit-reaper
  # grok-linux _exit()s; leftover runsvdir (bash -lc → start-services.sh)
  # stay PRoot tracees. Match args/exe, not truncated comm. Reap NEW only.
  _tmp="\${TMPDIR:-\${TMP:-/tmp}}"
  _out=\$(mktemp "\${_tmp}/grok-p-out.XXXXXX") || exit 1
  _err=\$(mktemp "\${_tmp}/grok-p-err.XXXXXX") || exit 1
  _before=\$(mktemp "\${_tmp}/grok-p-rsv.XXXXXX") || exit 1
  ps -eo pid= -o args= 2>/dev/null | awk '
    \$2 ~ /\\/runsvdir\$/ || \$2 == "runsvdir" { print \$1 }
  ' | sort >"\${_before}" 2>/dev/null || :
  trap '
    if [ -n "\${_pid:-}" ]; then
      kill -TERM "\${_pid}" 2>/dev/null || true
      sleep 1
      kill -KILL "\${_pid}" 2>/dev/null || true
    fi
    rm -f "\${_out}" "\${_err}" "\${_before}"
    exit 130
  ' INT TERM TSTP
  "\${_p}" \${_k} \${_svc} ${_gew_bind}"\${_g}" \${_nau} "\$@" >"\${_out}" 2>"\${_err}" &
  _pid=\$!
  (
    trap '' TSTP INT
    _seen=0
    _osize=0
    _idle_since=0
    _start=\$(date +%s)
    while :; do
      _now=\$(date +%s)
      if [ \$((_now - _start)) -ge 180 ]; then
        break
      fi
      if ! kill -0 "\${_pid}" 2>/dev/null; then
        exit 0
      fi
      _child=\$(ps -eo pid= -o ppid= -o args= 2>/dev/null | awk -v col="\${_pid}" '
        {
          pid=\$1; ppid=\$2; arg=\$3
          p[pid]=ppid
          a[pid]=arg
        }
        END {
          for (i in a) {
            if (a[i] !~ /grok-linux/) continue
            c=i
            for (n=0; n<32; n++) {
              if (c == col) { print i; exit }
              if (!(c in p)) break
              if (p[c] == c || p[c] + 0 == 0) break
              c=p[c]
            }
          }
        }
      ')
      if [ -n "\${_child}" ]; then
        _seen=1
      elif [ "\${_seen}" -eq 1 ]; then
        break
      fi
      _sz=\$(wc -c <"\${_out}" 2>/dev/null | tr -d ' \\t\\n')
      _sz=\${_sz:-0}
      if [ "\${_sz}" -gt 0 ]; then
        if [ "\${_sz}" -ne "\${_osize}" ]; then
          _osize=\${_sz}
          _idle_since=\${_now}
        elif [ "\${_idle_since}" -gt 0 ] && [ \$((_now - _idle_since)) -ge 1 ]; then
          break
        fi
      else
        if [ -s "\${_err}" ]; then
          _errsnip=\$(tr '\\n' ' ' <"\${_err}" 2>/dev/null)
          case "\${_errsnip}" in
            *'terminated with signal'*|*'os error 11'*|*"can't spawn"*)
              break
              ;;
          esac
        fi
      fi
      sleep 1
    done
    ps -eo pid= -o args= 2>/dev/null | awk '
      \$2 ~ /\\/runsvdir\$/ || \$2 == "runsvdir" { print \$1 }
    ' | sort | while read -r _rpid; do
      [ -n "\${_rpid}" ] || continue
      if ! grep -qx "\${_rpid}" "\${_before}" 2>/dev/null; then
        kill "\${_rpid}" 2>/dev/null || :
      fi
    done
    kill "\${_pid}" 2>/dev/null || :
    kill -KILL "\${_pid}" 2>/dev/null || :
    exit 0
  ) &
  _reaper=\$!
  wait "\${_reaper}" 2>/dev/null || :
  wait "\${_pid}" 2>/dev/null || :
  trap - INT TERM TSTP
  if [ -s "\${_err}" ]; then
    cat "\${_err}" >&2
  fi
  if [ -s "\${_out}" ]; then
    cat "\${_out}"
    rm -f "\${_out}" "\${_err}" "\${_before}"
    exit 0
  fi
  rm -f "\${_out}" "\${_err}" "\${_before}"
  exit 1
fi
exec "\${_p}" \${_k} \${_svc} ${_gew_bind}"\${_g}" "\$@"
EOF
    else
        cat > "${_gew_path}" <<EOF
#!/bin/sh
unset LD_PRELOAD
TERMUX_EXEC_OPTOUT=1
export TERMUX_EXEC_OPTOUT
_pflag=0
_nau=""
for _a in "\$@"; do
  case "\${_a}" in
    -p|--single|--prompt-file|--prompt-json) _pflag=1 ;;
    --no-auto-update) _nau="have" ;;
  esac
done
if [ "\${_pflag}" -eq 1 ] && [ "\${_nau}" != "have" ]; then
  _nau="--no-auto-update"
else
  _nau=""
fi
if [ "\${_pflag}" -eq 1 ]; then
  trap '
    if [ -n "\${_pid:-}" ]; then
      kill -TERM "\${_pid}" 2>/dev/null || true
      sleep 1
      kill -KILL "\${_pid}" 2>/dev/null || true
    fi
    exit 130
  ' INT TERM
  ${_gew_q} \${_nau} "\$@" &
  _pid=\$!
  wait "\${_pid}"
  _ec=\$?
  trap - INT TERM
  exit "\${_ec}"
fi
exec ${_gew_q} "\$@"
EOF
    fi
    if [ ! -s "${_gew_path}" ]; then
        unset _gew_path _gew_vendor _gew_method _gew_q
        return 1
    fi
    chmod 0755 "${_gew_path}" || return 1
    unset _gew_path _gew_vendor _gew_method _gew_q _gew_resolv _gew_bind _gew_rq
    return 0
}

# =============================================================================
# gc_setup_place_android_wrapper() - vendor file + POSIX grok/agent wrapper
# =============================================================================
#
# GENERAL PURPOSE:
# Move the smoked download into downloads/grok-{{os}}-{{arch}} and write
# bin/grok as an exec wrapper (rule 18c). Does not patch vendor bytes.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_place_android_wrapper() {
    _gpa_src="${1:-}"
    _gpa_download_dir="${2:-}"
    _gpa_bin_dir="${3:-}"
    _gpa_platform="${4:-}"
    _gpa_method="${5:-optout}"
    _gpa_final="${_gpa_download_dir}/grok-${_gpa_platform}"
    mkdir -p "${_gpa_download_dir}" "${_gpa_bin_dir}" || return 1
    mv -f "${_gpa_src}" "${_gpa_final}" || return 1
    chmod 0755 "${_gpa_final}" || return 1
    if ! gc_setup_write_exec_wrapper "${_gpa_bin_dir}/grok" "${_gpa_final}" "${_gpa_method}"; then
        return 1
    fi
    ln -sf grok "${_gpa_bin_dir}/agent" || return 1
    unset _gpa_src _gpa_download_dir _gpa_bin_dir _gpa_platform _gpa_method _gpa_final
    return 0
}

# =============================================================================
# gc_setup_heal_android_wrapper() - rewrite a stale Termux grok wrapper
# =============================================================================
#
# GENERAL PURPOSE:
# When grok already runs, setup skips the download. An older POSIX
# wrapper (exec proot, no --kill-on-exit, no -p SIGKILL) still hangs
# after grok -p prints. Rewrite bin/grok from the existing vendor file
# with no network. Also called from self-update and the session probe
# so a grok-cli-only channel update still heals. No-op when not Android,
# not a wrapper, or already current. Does not byte-patch the vendor file.
#
# $1 = peer path (bin/grok)
#
# ALIGNMENT: requirement-grok-setup.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-07: operators who already had grok installed would never get
# the hang fix without --force (a full re-download). Heal on skip.
# INC-20260907-002.
#
# Last updated: 2026-09-07
# =============================================================================
gc_setup_heal_android_wrapper() {
    : "${APP_NAME:=grok-cli}"
    GC_SETUP_WRAPPER_HEALED=0
    _haw_peer="${1:-}"
    if [ -z "${_haw_peer}" ] || [ ! -f "${_haw_peer}" ]; then
        unset _haw_peer
        return 0
    fi
    if ! gc_setup_host_is_android; then
        unset _haw_peer
        return 0
    fi
    _haw_head=$(head -n1 "${_haw_peer}" 2>/dev/null || true)
    case "${_haw_head}" in
        "#!/bin/sh"|"#!/bin/sh ") ;;
        *)
            unset _haw_peer _haw_head
            return 0
            ;;
    esac
    if grep -q kill-on-exit "${_haw_peer}" 2>/dev/null; then
        if grep -q no-auto-update "${_haw_peer}" 2>/dev/null; then
            if grep -q proot-exit-reaper "${_haw_peer}" 2>/dev/null; then
                if grep -q 'profile.d/start-services.sh' "${_haw_peer}" 2>/dev/null; then
                    unset _haw_peer _haw_head
                    return 0
                fi
            fi
        fi
    fi
    _haw_g=$(grep '^_g=' "${_haw_peer}" 2>/dev/null | head -n1 | sed "s/^_g=//; s/^'//; s/'\$//")
    _haw_method="optout"
    if grep -q 'command -v proot' "${_haw_peer}" 2>/dev/null; then
        _haw_method="proot"
    fi
    if [ -z "${_haw_g}" ] || [ ! -f "${_haw_g}" ]; then
        _haw_home=$(gc_resolve_grok_home)
        _haw_plat=$(gc_setup_detect_platform) || _haw_plat=""
        if [ -n "${_haw_plat}" ] && [ -f "${_haw_home}/downloads/grok-${_haw_plat}" ]; then
            _haw_g="${_haw_home}/downloads/grok-${_haw_plat}"
        fi
    fi
    if [ -z "${_haw_g}" ] || [ ! -f "${_haw_g}" ]; then
        unset _haw_peer _haw_head _haw_g _haw_method _haw_home _haw_plat
        return 0
    fi
    _haw_home=$(gc_resolve_grok_home)
    _haw_resolv=""
    if [ -s "${_haw_home}/resolv.conf" ]; then
        _haw_resolv="${_haw_home}/resolv.conf"
    fi
    _haw_dir=$(dirname "${_haw_peer}")
    if gc_setup_write_exec_wrapper "${_haw_peer}" "${_haw_g}" "${_haw_method}" "${_haw_resolv}"; then
        ln -sf grok "${_haw_dir}/agent" 2>/dev/null || true
        out_info "Rewrote ${_haw_peer} so grok -p can exit (proot-exit-reaper; vendor binary unchanged). Next: grok -p hello"
        GC_SETUP_WRAPPER_HEALED=1
    fi
    unset _haw_peer _haw_head _haw_g _haw_method _haw_home _haw_plat _haw_resolv _haw_dir
    return 0
}

# =============================================================================
# gc_setup_host_resolv_ok() - 0 if probe resolv has a nameserver line
# =============================================================================
gc_setup_host_resolv_ok() {
    : "${GROK_SETUP_RESOLV_FILE:=/etc/resolv.conf}"
    if [ -s "${GROK_SETUP_RESOLV_FILE}" ] && grep -q '^nameserver' "${GROK_SETUP_RESOLV_FILE}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_setup_write_resolv_conf() - nameserver file for musl via proot bind
# =============================================================================
#
# GENERAL PURPOSE:
# Static vendor grok (musl) reads /etc/resolv.conf. Termux /etc has no
# nameserver. Write GROK_HOME/resolv.conf without patching the binary.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_write_resolv_conf() {
    _grc_dest="${1:-}"
    if [ -z "${_grc_dest}" ]; then
        return 1
    fi
    _grc_tmp=$(util_mktemp resolv)
    if [ -z "${_grc_tmp}" ]; then
        return 1
    fi
    : > "${_grc_tmp}"
    if [ -n "${PREFIX:-}" ] && [ -f "${PREFIX}/etc/resolv.conf" ]; then
        grep '^nameserver' "${PREFIX}/etc/resolv.conf" >> "${_grc_tmp}" 2>/dev/null || true
    fi
    if ! grep -q '^nameserver' "${_grc_tmp}" 2>/dev/null; then
        if command -v getprop >/dev/null 2>&1; then
            _grc_d1=$(getprop net.dns1 2>/dev/null || true)
            _grc_d2=$(getprop net.dns2 2>/dev/null || true)
            if [ -n "${_grc_d1}" ]; then
                printf 'nameserver %s\n' "${_grc_d1}" >> "${_grc_tmp}"
            fi
            if [ -n "${_grc_d2}" ]; then
                printf 'nameserver %s\n' "${_grc_d2}" >> "${_grc_tmp}"
            fi
        fi
    fi
    if ! grep -q '^nameserver' "${_grc_tmp}" 2>/dev/null; then
        printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >> "${_grc_tmp}"
    fi
    mv -f "${_grc_tmp}" "${_grc_dest}" || return 1
    chmod 0644 "${_grc_dest}" 2>/dev/null || true
    unset _grc_dest _grc_tmp _grc_d1 _grc_d2
    return 0
}

# =============================================================================
# gc_setup_maybe_android_dns() - bind GROK_HOME/resolv.conf via proot
# =============================================================================
#
# GENERAL PURPOSE:
# After Android place, if the host resolv probe has no nameserver, write
# a resolv file and rewrite bin/grok to proot -b that file over
# /etc/resolv.conf so grok login can resolve auth.x.ai.
#
# $1 = vendor file; $2 = bin dir; $3 = grok home
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_maybe_android_dns() {
    _gad_vendor="${1:-}"
    _gad_bin_dir="${2:-}"
    _gad_home="${3:-}"
    : "${APP_NAME:=grok-cli}"
    if [ -z "${_gad_vendor}" ] || [ ! -f "${_gad_vendor}" ] || [ -z "${_gad_bin_dir}" ] || [ -z "${_gad_home}" ]; then
        return 0
    fi
    if ! gc_setup_host_is_android; then
        return 0
    fi
    if gc_setup_host_resolv_ok; then
        unset _gad_vendor _gad_bin_dir _gad_home
        return 0
    fi
    _gad_resolv="${_gad_home}/resolv.conf"
    if ! gc_setup_write_resolv_conf "${_gad_resolv}"; then
        out_info "This host has no usable /etc/resolv.conf, so grok may fail DNS (common on Termux). Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! command -v proot >/dev/null 2>&1; then
        gc_setup_ensure_termux_proot
    fi
    if ! command -v proot >/dev/null 2>&1; then
        out_info "Wrote ${_gad_resolv}, but proot is not on PATH so grok cannot bind it over /etc/resolv.conf. grok login may fail DNS. Next: pkg install proot, then ${APP_NAME} setup --force, or export XAI_API_KEY."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! gc_setup_smoke_version "${_gad_vendor}" proot; then
        out_info "Wrote ${_gad_resolv}, but proot cannot run grok here. grok login may fail DNS. Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! gc_setup_write_exec_wrapper "${_gad_bin_dir}/grok" "${_gad_vendor}" proot "${_gad_resolv}"; then
        out_info "Wrote ${_gad_resolv}, but could not rewrite the grok wrapper. Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    ln -sf grok "${_gad_bin_dir}/agent" 2>/dev/null || true
    out_info "Bound ${_gad_resolv} over /etc/resolv.conf via proot so grok can resolve auth.x.ai (vendor binary unchanged)."
    unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
    return 0
}

# =============================================================================
# gc_setup_maybe_bashrc() - append vendor-style PATH block for bash or zsh
# =============================================================================
#
# ALIGNMENT: requirement-grok-setup.md · requirement-shell-zshenv.md
# bash → ~/.bashrc; zsh → ~/.zshenv (not ~/.zshrc).
# Last reviewed: 2026-09-17
# =============================================================================
gc_setup_maybe_bashrc() {
    _gmb_bin_dir="${1:-}"
    _gmb_shell=$(basename "${SHELL:-}")
    case "${_gmb_shell}" in
        bash)
            _gmb_rc="${HOME}/.bashrc"
            ;;
        zsh)
            : "${ZSHENV:=${HOME}/.zshenv}"
            _gmb_rc="${ZSHENV}"
            ;;
        *)
            return 0
            ;;
    esac
    if grep -qs "grok installer" "${_gmb_rc}" 2>/dev/null; then
        return 0
    fi
    printf '\n# >>> grok installer >>>\nexport PATH="%s:$PATH"\n# <<< grok installer <<<\n' "${_gmb_bin_dir}" >> "${_gmb_rc}" 2>/dev/null || true
    return 0
}

# =============================================================================
# gc_setup_already_installed_menu() - TTY keep / reinstall / Exit for setup
# =============================================================================
#
# GENERAL PURPOSE:
# When grok already runs on this host and setup is interactive, print a
# numbered list: keep the existing grok, remove it and install again, or
# Exit. Choice is current-shell prompt_ask (PROMPT_ASK_VALUE). Does not
# fetch. Does not wipe GROK_HOME or auth.*. Caller applies the choice
# via GC_SETUP_ALREADY_CHOICE (keep | reinstall | cancel).
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-interface.md
#
# Last updated: 2026-09-12
# =============================================================================
gc_setup_already_installed_menu() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    : "${PROMPT_ASK_VALUE:=}"
    _gsaim_peer="${1:-}"
    GC_SETUP_ALREADY_CHOICE="keep"

    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        return 0
    fi

    out_info "$(util_app_ident) — setup"
    if [ -n "${_gsaim_peer}" ]; then
        out_info "grok is already installed at ${_gsaim_peer}."
    fi
    out_menu_choice "1" "keep" "Leave the existing grok"
    out_menu_choice "2" "reinstall" "Remove existing grok and install again"
    out_menu_choice "9" "Exit"
    # MUST NOT wrap prompt_ask in command substitution (T1-PROMPT-CAPTURE).
    prompt_ask "Choice" "1"
    _gsaim_pick="${PROMPT_ASK_VALUE}"
    case "${_gsaim_pick}" in
        2|reinstall|Reinstall)
            GC_SETUP_ALREADY_CHOICE="reinstall"
            ;;
        9|exit|quit|Exit|QUIT)
            GC_SETUP_ALREADY_CHOICE="cancel"
            ;;
        1|keep|Keep|"")
            GC_SETUP_ALREADY_CHOICE="keep"
            ;;
        *)
            out_info "Not a setup choice. Keeping the existing grok."
            GC_SETUP_ALREADY_CHOICE="keep"
            ;;
    esac
    unset _gsaim_peer _gsaim_pick
    return 0
}

# =============================================================================
# gc_setup() - Type 0: place peer grok via studied xAI channel + artifact
# =============================================================================
#
# GENERAL PURPOSE:
# Detect platform, fetch the channel version pointer, download
# grok-{version}-{os}-{arch} into GROK_HOME/downloads (not cache/tmp),
# refuse a wrong ELF machine, smoke --version there, and link
# ~/.grok/bin/grok (and agent). On Android, retry ET_EXEC via
# TERMUX_EXEC_OPTOUT, Termux pkg install -y proot when missing, or
# proot, and place a wrapper — do not byte-patch.
# MUST NOT download or exec install.sh. MUST NOT require bash. Skip if
# grok already runs on this host unless --force or a TTY reinstall pick.
# An x86_64 file copied onto aarch64 Termux is not a skip. grok on disk
# is success even when this session's PATH is stale. A stale Android
# proot wrapper is rewritten on keep (no network) so grok -p can exit.
# GC_SETUP_AS_UPDATE=1 (update-grok): always fetch (FORCE); JSON type
# update-grok; success says updated. MUST NOT exec grok auto-update.
# GC_SETUP_AS_REINSTALL=1 (reinstall): always fetch (FORCE); JSON type
# reinstall; success says reinstalled. MUST NOT wipe auth.* / GROK_HOME.
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-shell-cli-interface.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-operator-readable-error.md
#
# Last updated: 2026-09-12
# =============================================================================
gc_setup() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    : "${FORCE:=0}"
    : "${GC_SETUP_AS_UPDATE:=0}"
    : "${GC_SETUP_AS_REINSTALL:=0}"
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    : "${GROK_CHANNEL:=stable}"
    : "${GROK_PEER_NAME:=grok}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    _peer=$(gc_resolve_grok_peer)
    _host_platform=$(gc_setup_detect_platform) || _host_platform=""
    _host_arch=""
    if [ -n "${_host_platform}" ]; then
        _host_arch="${_host_platform#*-}"
    fi
    if [ -n "${_peer}" ] && [ "${FORCE}" -ne 1 ]; then
        if gc_setup_peer_usable "${_peer}" "${_host_arch}"; then
            if [ "${GC_SETUP_AS_UPDATE}" -ne 1 ] && [ "${JSON}" -ne 1 ] && [ "${QUIET}" -ne 1 ] && [ "${TTY}" -eq 1 ]; then
                gc_setup_already_installed_menu "${_peer}"
                case "${GC_SETUP_ALREADY_CHOICE}" in
                    reinstall)
                        FORCE=1
                        export FORCE
                        out_info "Removing existing grok and installing again. The current file stays until the new download passes --version."
                        ;;
                    cancel)
                        out_info "Setup cancelled."
                        return 0
                        ;;
                    *)
                        gc_setup_heal_android_wrapper "${_peer}"
                        out_success "grok is already installed at ${_peer}."
                        gc_setup_print_next "${_peer}"
                        return 0
                        ;;
                esac
            else
                gc_setup_heal_android_wrapper "${_peer}"
                out_success "grok is already installed at ${_peer}."
                gc_setup_print_next "${_peer}"
                if [ "${JSON}" -eq 1 ]; then
                    _on_path="false"
                    gc_peer_on_current_path && _on_path="true"
                    out_json "setup" "grok is already installed at ${_peer}." \
                        "app" "${APP_NAME}" \
                        "status" "already_installed" \
                        "peer" "${GROK_PEER_NAME}" \
                        "peer_path" "${_peer}" \
                        "on_path" "${_on_path}" \
                        "vendor_base" "${GROK_VENDOR_BASE_URL}"
                fi
                return 0
            fi
        fi
        if [ -n "${GC_SETUP_PEER_UNUSABLE:-}" ]; then
            out_info "Existing grok at ${_peer} cannot run on this host (${GC_SETUP_PEER_UNUSABLE}). Fetching a matching grok."
        fi
    fi

    if ! command -v curl >/dev/null 2>&1; then
        out_die "curl is not on PATH, so ${APP_NAME} cannot download grok. Next: install curl, then ${APP_NAME} setup."
    fi
    if ! command -v uname >/dev/null 2>&1; then
        out_die "uname is not on PATH, so ${APP_NAME} cannot detect the grok platform. Next: install uname, then ${APP_NAME} setup."
    fi

    case "${GROK_CHANNEL}" in
        stable|alpha|enterprise) ;;
        *)
            out_die "Invalid GROK_CHANNEL (${GROK_CHANNEL}). Next: set GROK_CHANNEL to stable, alpha, or enterprise, then ${APP_NAME} setup."
            ;;
    esac

    if [ -n "${_host_platform}" ]; then
        _platform="${_host_platform}"
    else
        _platform=$(gc_setup_detect_platform) || _platform=""
    fi
    if [ -z "${_platform}" ]; then
        out_die "Unsupported OS or architecture ($(uname -s)/$(uname -m)). Next: use linux, macos, or Git Bash/MSYS/Cygwin on x86_64 or aarch64, then ${APP_NAME} setup. Native Windows PowerShell uses irm https://x.ai/cli/install.ps1 | iex."
    fi
    _want_arch="${_platform#*-}"

    if [ "${GC_SETUP_AS_UPDATE}" -eq 1 ]; then
        out_info "Starting the update of grok from xAI (${GROK_CHANNEL}). This does not use grok auto-update."
    elif [ "${GC_SETUP_AS_REINSTALL}" -eq 1 ]; then
        out_info "Starting the reinstall of grok from xAI (${GROK_CHANNEL}). This does not use grok auto-update."
    fi
    if [ -n "${GROK_SETUP_VERSION:-}" ]; then
        if ! gc_setup_version_ok "${GROK_SETUP_VERSION}"; then
            out_die "Invalid GROK_SETUP_VERSION (${GROK_SETUP_VERSION}). Next: use X.Y.Z, then ${APP_NAME} setup."
        fi
        _version="${GROK_SETUP_VERSION}"
    else
        out_info "Fetching latest ${GROK_CHANNEL} grok version from ${GROK_VENDOR_BASE_URL}"
        GC_SETUP_POINTER=""
        if gc_setup_read_pointer "${GROK_CHANNEL}"; then
            _version="${GC_SETUP_POINTER}"
        else
            _version=""
        fi
        if [ -z "${_version}" ]; then
            _ptr_det="${GC_SETUP_CURL_DETAIL:-}"
            if [ -n "${_ptr_det}" ]; then
                out_die "Download of the grok version pointer failed (${_ptr_det} from ${GROK_VENDOR_BASE_URL}/${GROK_CHANNEL}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
            fi
            out_die "Download of the grok version pointer failed (${GROK_VENDOR_BASE_URL}/${GROK_CHANNEL}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
        fi
    fi

    _home_grok=$(gc_resolve_grok_home)
    _download_dir="${_home_grok}/downloads"
    if [ -n "${GROK_BIN_DIR:-}" ]; then
        _bin_dir="${GROK_BIN_DIR}"
    else
        _bin_dir="${_home_grok}/bin"
    fi
    if ! mkdir -p "${_download_dir}"; then
        out_die "Could not create ${_download_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    # Studied installer smokes from ~/.grok/downloads (exec-capable). Cache
    # /tmp /dev/shm may be noexec (Termux/Android). Do not use util_mktemp.
    _tmp=$(mktemp "${_download_dir}/grok-${_platform}.XXXXXX" 2>/dev/null || true)
    if [ -z "${_tmp}" ] || [ ! -f "${_tmp}" ]; then
        out_die "Could not create a temp file for the grok binary. Next: check disk under ${_download_dir}, then ${APP_NAME} setup."
    fi
    out_info "Downloading grok ${_version} (${_platform})"
    if ! gc_setup_fetch_artifact "${_version}" "${_platform}" "${_tmp}"; then
        rm -f "${_tmp}"
        _bin_det="${GC_SETUP_CURL_DETAIL:-}"
        if [ -n "${_bin_det}" ]; then
            out_die "Download of the grok binary failed (${_bin_det} for grok-${_version}-${_platform}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
        fi
        out_die "Download of the grok binary failed (grok-${_version}-${_platform}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
    fi
    if ! chmod 0755 "${_tmp}"; then
        rm -f "${_tmp}"
        out_die "Could not chmod the downloaded grok under ${_download_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    _got_elf=""
    case "${_platform}" in
        windows-*) ;;
        *)
            _got_elf=$(gc_setup_elf_arch "${_tmp}") || _got_elf=""
            ;;
    esac
    if [ -n "${_got_elf}" ] && [ -n "${_want_arch}" ] && [ "${_got_elf}" != "${_want_arch}" ]; then
        rm -f "${_tmp}"
        out_die "The downloaded grok is the wrong architecture (${_got_elf} ELF, this host needs ${_want_arch} / ${_platform}). This did not install ${APP_NAME}. Next: run ${APP_NAME} setup --force on this device (do not scp grok from an x86_64 host onto aarch64 Termux), then ${APP_NAME} setup."
    fi
    GC_SETUP_SMOKE_METHOD="direct"
    if ! gc_setup_smoke_version "${_tmp}"; then
        _smoke_detail="${GC_SETUP_SMOKE_DETAIL:-}"
        case "${_smoke_detail}" in
            *EM_X86_64*|*EM_AARCH64*|*EM_X86*)
                rm -f "${_tmp}"
                out_die "The downloaded grok is the wrong architecture for this host (${_smoke_detail}). This did not install ${APP_NAME}. Next: run ${APP_NAME} setup --force on this device (do not scp grok from an x86_64 host onto aarch64 Termux), then ${APP_NAME} setup."
                ;;
        esac
        if gc_setup_host_is_android; then
            if gc_setup_smoke_android "${_tmp}"; then
                out_info "This Android host cannot run the vendor grok file directly; ${APP_NAME} will place a wrapper under ${_bin_dir} (vendor binary unchanged)."
            else
                _smoke_msg="The downloaded grok is a static Linux executable that this Android host refused to run"
                if [ -n "${GC_SETUP_SMOKE_DETAIL:-}" ]; then
                    _smoke_msg="${_smoke_msg} (${GC_SETUP_SMOKE_DETAIL})"
                elif [ -n "${_smoke_detail}" ]; then
                    _smoke_msg="${_smoke_msg} (${_smoke_detail})"
                fi
                if gc_setup_keep_failed_download "${_tmp}" "${_download_dir}" "${_platform}"; then
                    _kept="${GC_SETUP_FAILED_PATH}"
                else
                    _kept="${_tmp}"
                fi
                out_die "${_smoke_msg}. Left the file at ${_kept}. This did not install ${APP_NAME}. Next: pkg install proot, then ${APP_NAME} setup --force (or run grok on a Linux host)."
            fi
        else
            _smoke_msg="The downloaded grok failed to run --version"
            if [ -n "${_smoke_detail}" ]; then
                _smoke_msg="${_smoke_msg} (${_smoke_detail})"
            fi
            rm -f "${_tmp}"
            out_die "${_smoke_msg}. This did not install ${APP_NAME}. Next: check the download, then ${APP_NAME} setup."
        fi
    fi
    case "${_platform}" in
        windows-*)
            if ! gc_setup_place_windows_exe "${_tmp}" "${_download_dir}" "${_bin_dir}" "${_platform}"; then
                rm -f "${_tmp}"
                out_die "Could not place grok.exe under ${_bin_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
            fi
            gc_setup_maybe_bashrc "${_bin_dir}"
            out_info "To use grok from cmd.exe or PowerShell, add %USERPROFILE%\\.grok\\bin to your User PATH (Git Bash already uses ~/.grok/bin after a new terminal)."
            ;;
        *)
            if [ "${GC_SETUP_SMOKE_METHOD}" = "optout" ] || [ "${GC_SETUP_SMOKE_METHOD}" = "proot" ]; then
                if ! gc_setup_place_android_wrapper "${_tmp}" "${_download_dir}" "${_bin_dir}" "${_platform}" "${GC_SETUP_SMOKE_METHOD}"; then
                    rm -f "${_tmp}"
                    out_die "Could not place grok under ${_bin_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
                fi
            else
                if ! gc_setup_place_links "${_tmp}" "${_download_dir}" "${_bin_dir}" "${_platform}"; then
                    rm -f "${_tmp}"
                    out_die "Could not place grok under ${_bin_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
                fi
            fi
            gc_setup_path_symlink "${_bin_dir}"
            gc_setup_maybe_bashrc "${_bin_dir}"
            _placed_vendor="${_download_dir}/grok-${_platform}"
            if [ -f "${_placed_vendor}" ]; then
                gc_setup_maybe_android_dns "${_placed_vendor}" "${_bin_dir}" "${_home_grok}"
            fi
            ;;
    esac
    if ! gc_setup_host_is_android; then
        if ! gc_setup_host_resolv_ok; then
            out_info "This host has no usable /etc/resolv.conf, so grok may fail DNS (common on Termux). Next: export XAI_API_KEY, or grok login from a host with working DNS."
        fi
    fi

    _peer=$(gc_resolve_grok_peer)
    if [ -z "${_peer}" ]; then
        out_die "The download finished but grok was not found under ${_bin_dir} or ${USER_BIN}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    if [ "${GC_SETUP_AS_UPDATE}" -eq 1 ]; then
        out_success "grok is updated at ${_peer}."
    elif [ "${GC_SETUP_AS_REINSTALL}" -eq 1 ]; then
        out_success "grok is reinstalled at ${_peer}."
    else
        out_success "grok is installed at ${_peer}."
    fi
    gc_setup_print_next "${_peer}"
    if [ "${JSON}" -eq 1 ]; then
        _on_path="false"
        gc_peer_on_current_path && _on_path="true"
        if [ "${GC_SETUP_AS_UPDATE}" -eq 1 ]; then
            out_json "update-grok" "grok is updated at ${_peer}." \
                "app" "${APP_NAME}" \
                "status" "updated" \
                "peer" "${GROK_PEER_NAME}" \
                "peer_path" "${_peer}" \
                "on_path" "${_on_path}" \
                "vendor_base" "${GROK_VENDOR_BASE_URL}" \
                "version" "${_version}" \
                "platform" "${_platform}"
        elif [ "${GC_SETUP_AS_REINSTALL}" -eq 1 ]; then
            out_json "reinstall" "grok is reinstalled at ${_peer}." \
                "app" "${APP_NAME}" \
                "status" "reinstalled" \
                "peer" "${GROK_PEER_NAME}" \
                "peer_path" "${_peer}" \
                "on_path" "${_on_path}" \
                "vendor_base" "${GROK_VENDOR_BASE_URL}" \
                "version" "${_version}" \
                "platform" "${_platform}"
        else
            out_json "setup" "grok is installed at ${_peer}." \
                "app" "${APP_NAME}" \
                "status" "installed" \
                "peer" "${GROK_PEER_NAME}" \
                "peer_path" "${_peer}" \
                "on_path" "${_on_path}" \
                "vendor_base" "${GROK_VENDOR_BASE_URL}" \
                "version" "${_version}" \
                "platform" "${_platform}"
        fi
    fi
    return 0
}

