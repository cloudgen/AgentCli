# =============================================================================
# inst_self_uninstall_cleanup_path() - Remove grok-cli stickers; PATH only if safe
# =============================================================================
#
# ALIGNMENT: requirement-shell-path-and-shell-support.md · requirement-shell-zshenv.md
# MUST match "# Added by grok-cli installer" only — never "# Added by .* installer".
# MUST NOT delete .profile, vendor grok installer block, or login-hook scraps.
# Last reviewed: 2026-09-09
# =============================================================================
inst_self_uninstall_cleanup_path() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        return 0
    fi
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${BASHRC:=${HOME}/.bashrc}"
    : "${ZSHENV:=${HOME}/.zshenv}"
    : "${ZSHRC:=${HOME}/.zshrc}"
    : "${FISH_CONFIG:=${HOME}/.config/fish/config.fish}"
    : "${PROFILE:=${HOME}/.profile}"
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    _cup_should_path=1
    if [ -d "${USER_BIN}" ]; then
        if [ -n "$(ls -A "${USER_BIN}" 2>/dev/null)" ]; then
            _cup_should_path=0
            if [ "${JSON}" -eq 0 ]; then
                out_warn "Keeping ${USER_BIN} in PATH because it still contains files."
            fi
        fi
    fi
    _cup_path=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")
    _cup_fish=$(printf 'set -gx PATH %s $PATH' "${USER_BIN}")
    _cup_prefix="# Added by ${APP_NAME} installer"
    for _cup_cfg in "${BASHRC}" "${ZSHENV}" "${ZSHRC}" "${FISH_CONFIG}" "${PROFILE}"; do
        [ -f "${_cup_cfg}" ] || continue
        _cup_tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.rc.XXXXXX" 2>/dev/null || mktemp)
        while IFS= read -r _cup_line || [ -n "${_cup_line}" ]; do
            case "${_cup_line}" in
                "${_cup_prefix}"*)
                    continue
                    ;;
            esac
            if [ "${_cup_should_path}" -eq 1 ]; then
                if [ "${_cup_line}" = "${_cup_path}" ] || [ "${_cup_line}" = "${_cup_fish}" ]; then
                    continue
                fi
            fi
            printf '%s\n' "${_cup_line}"
        done < "${_cup_cfg}" > "${_cup_tmp}"
        mv -f "${_cup_tmp}" "${_cup_cfg}"
    done
    return 0
}

# =============================================================================
# util_sha256_file() - SHA-256 hex digest of a file (portable tool chain)
# =============================================================================
#
# GENERAL PURPOSE:
# Print the SHA-256 hex digest of file $1 to stdout for capture.
# Tries sha256sum (GNU/Linux) → shasum -a 256 (macOS) → openssl dgst.
# Return 1 if no tool or file unreadable.
#
# PRINTF/ECHO EXCEPTION (class B – return-via-stdout):
# Digests are data returns for $(util_sha256_file …), not product UI.
# =============================================================================
util_sha256_file() {
    _usf_file="${1-}"
    _usf_dig=""
    if [ -z "${_usf_file}" ] || [ ! -f "${_usf_file}" ]; then
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        _usf_dig=$(sha256sum "${_usf_file}" 2>/dev/null | awk '{ print $1; exit }')
    elif command -v shasum >/dev/null 2>&1; then
        _usf_dig=$(shasum -a 256 "${_usf_file}" 2>/dev/null | awk '{ print $1; exit }')
    elif command -v openssl >/dev/null 2>&1; then
        _usf_dig=$(openssl dgst -sha256 "${_usf_file}" 2>/dev/null | awk '{ print $NF; exit }')
    else
        return 1
    fi
    if [ -z "${_usf_dig}" ]; then
        return 1
    fi
    printf '%s\n' "${_usf_dig}"
    return 0
}

# =============================================================================
# util_fetch_remote_version() - Class B: VERSION= from SCRIPT_URL body
# =============================================================================
util_fetch_remote_version() {
    _ufr_url="${1-}"
    _ufr_body=""
    if [ -z "${_ufr_url}" ]; then
        return 1
    fi
    if command -v curl >/dev/null 2>&1; then
        _ufr_body=$(curl -fsSL --connect-timeout 3 --max-time 8 "${_ufr_url}" 2>/dev/null) || _ufr_body=""
    elif command -v wget >/dev/null 2>&1; then
        _ufr_body=$(wget -qO- -T 8 "${_ufr_url}" 2>/dev/null) || _ufr_body=""
    else
        return 1
    fi
    if [ -z "${_ufr_body}" ]; then
        return 1
    fi
    printf '%s\n' "${_ufr_body}" | grep '^VERSION="' | head -n1 | cut -d'"' -f2
    return 0
}

# =============================================================================
# ver_gt() - POSIX semver compare; 0 if $1 > $2
# =============================================================================
ver_gt() {
    v1=$1
    v2=$2
    while [ -n "$v1" ] || [ -n "$v2" ]; do
        p1=${v1%%.*}
        p2=${v2%%.*}
        [ -z "$p1" ] && p1=0
        [ -z "$p2" ] && p2=0
        if [ "$p1" -gt "$p2" ]; then
            return 0
        fi
        if [ "$p1" -lt "$p2" ]; then
            return 1
        fi
        if [ "$v1" = "${v1#*.}" ]; then
            v1=""
        else
            v1=${v1#*.}
        fi
        if [ "$v2" = "${v2#*.}" ]; then
            v2=""
        else
            v2=${v2#*.}
        fi
    done
    return 1
}

util_get_install_bin_path() {
    # --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    # HOME before any ${HOME}/… path (INC-20260713-001 / set -u order)
    : "${APP_NAME:=app}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE_USER:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    local bin_path=""

    # Explicit force flags take precedence
    if [ "${FORCE_USER}" -eq 1 ]; then
        bin_path="${USER_BIN}/${APP_NAME}"
    elif [ "${FORCE_GLOBAL}" -eq 1 ] || [ "$(id -u)" -eq 0 ]; then
        bin_path="${GLOBAL_BIN}/${APP_NAME}"
    else
        # Normal non-root behavior: prefer user-local, fallback to global
        if [ -f "${USER_BIN}/${APP_NAME}" ]; then
            bin_path="${USER_BIN}/${APP_NAME}"
        elif [ -f "${GLOBAL_BIN}/${APP_NAME}" ]; then
            bin_path="${GLOBAL_BIN}/${APP_NAME}"
            if [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
                out_warn "Global installation found. Operating on it (you may need sudo for uninstall)."
            fi
        else
            bin_path="${USER_BIN}/${APP_NAME}"
        fi
    fi

    printf '%s' "${bin_path}"
}

# =============================================================================
# util_backup() - Create dated backup before any modification
# =============================================================================
#
# GENERAL PURPOSE:
# Creates a dated backup of a file or directory before destructive or
# modifying operations (rm -rf, sed, config changes).
#
# This implements CIAO Principle 10 (Right Backup & Restore Strategy).
#
# ────────────────────────────────────────────────
# CIAO PRINCIPLES APPLIED (v2.9.1)
# ────────────────────────────────────────────────
# Principle 1  (Caution)               - Safe path validation
# Principle 2  (Intentional Verbosity) - Full header + comments
# Principle 3  (Anti-fragile)          - Survives missing files gracefully
# Principle 7  (Reusable)              - Designed for reuse in other projects
# Principle 9  (Safe Temporary Files)  - Uses mktemp where needed
# Principle 10 (Backup Strategy)       - Dated backup with counter
#
# CRITICAL DEFENSIVE RULES:
# - Never modify files without creating backup first.
# - Refuse dangerous paths (/, $HOME, empty).
# - Backup name format: <name>.YYYYMMDD-N.bak
# - All messages go through out_text helpers only.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central backup mechanism. Any change must preserve dated backup
# naming and safety checks to prevent accidental data loss.
#
# Last reviewed: 29 April 2026
# =============================================================================

util_backup() {
    # --- Safe Variable Defaults ---
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    : "${PROJECT_NAME:=${APP_NAME}-demo}"
    : "${PROJECT_DIR:=${HOME}/${PROJECT_NAME}}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    local target="${1-}"
    local reason="${2:-pre-change}"

    if [ -z "$target" ]; then
        return 1
    fi

    # Safety check
    if [ "$target" = "/" ] || [ "$target" = "${HOME}" ] || [ -z "$target" ]; then
        out_warn "Refusing to backup dangerous path: $target"
        return 1
    fi

    local timestamp
    timestamp=$(date +%Y%m%d)
    local counter=1
    local backup_path

    if [ -d "$target" ]; then
        backup_path="${target}.${timestamp}-${counter}.bak"
        while [ -e "$backup_path" ]; do
            counter=$((counter + 1))
            backup_path="${target}.${timestamp}-${counter}.bak"
        done
        cp -a "$target" "$backup_path" 2>/dev/null && \
            out_info "Backup created: $backup_path (reason: $reason)" || \
            out_warn "Failed to create backup of directory $target"
    elif [ -f "$target" ]; then
        backup_path="${target}.${timestamp}-${counter}.bak"
        while [ -e "$backup_path" ]; do
            counter=$((counter + 1))
            backup_path="${target}.${timestamp}-${counter}.bak"
        done
        cp "$target" "$backup_path" 2>/dev/null && \
            out_info "Backup created: $backup_path (reason: $reason)" || \
            out_warn "Failed to create backup of file $target"
    fi
}

# =============================================================================
# Cache folder paths — per login, per process, under cache/
# =============================================================================
#
# Linux:  /dev/shm/cache/cache-${APP_NAME}-${login}-$$
#          then /tmp/cache/cache-${APP_NAME}-${login}-$$
#          then ${HOME}/.cache/cache-${APP_NAME}-$$
# Git Bash: /tmp/cache/cache-${APP_NAME}-${login}-$$
#          then ${HOME}/AppData/Local/Temp/cache-${APP_NAME}-$$
# Mac:    /tmp/cache/cache-${APP_NAME}-${login}-$$
#          then ${HOME}/Library/Caches/cache-${APP_NAME}-$$
#          then ${HOME}/cache/cache-${APP_NAME}-$$
# $$ is this process id. Home tiers omit the login (HOME already isolates).
# A missed tier is silent. MUST NOT use /dev/shm/${APP_NAME} or
# /dev/shm/${APP_NAME}-${USERNAME} (ram-drive project folders).
#
# ALIGNMENT: requirement-shell-cli-storage.md
# Test-purpose: GROK_CLI_CACHE_HOST=linux|gitbash|mac
#               GROK_CLI_CACHE_SKIP=preferred skips tier 1 with no message
# =============================================================================
util_cache_host_kind() {
    case "${GROK_CLI_CACHE_HOST:-}" in
        linux|gitbash|mac)
            printf '%s' "${GROK_CLI_CACHE_HOST}"
            return 0
            ;;
    esac
    if [ -n "${MSYSTEM:-}" ]; then
        printf '%s' "gitbash"
        return 0
    fi
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*) printf '%s' "gitbash" ;;
        Darwin) printf '%s' "mac" ;;
        *) printf '%s' "linux" ;;
    esac
}

util_cache_login() {
    _clogin="${USERNAME:-unknown}"
    case "${_clogin}" in
        *[!A-Za-z0-9._-]*)
            _clogin=$(printf '%s' "${_clogin}" | tr -c 'A-Za-z0-9._-' '_')
            ;;
    esac
    [ -n "${_clogin}" ] || _clogin="unknown"
    printf '%s' "${_clogin}"
}

util_cache_volatile_leaf() {
    : "${APP_NAME:=app}"
    printf '%s' "cache-${APP_NAME}-$(util_cache_login)-$$"
}

util_cache_home_leaf() {
    : "${APP_NAME:=app}"
    printf '%s' "cache-${APP_NAME}-$$"
}

util_preferred_cache_dir() {
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    case "$(util_cache_host_kind)" in
        gitbash|mac)
            printf '%s' "/tmp/cache/$(util_cache_volatile_leaf)"
            ;;
        *)
            printf '%s' "/dev/shm/cache/$(util_cache_volatile_leaf)"
            ;;
    esac
}

util_fallback_cache_dir() {
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    case "$(util_cache_host_kind)" in
        gitbash)
            printf '%s' "${HOME}/AppData/Local/Temp/$(util_cache_home_leaf)"
            ;;
        mac)
            printf '%s' "${HOME}/Library/Caches/$(util_cache_home_leaf)"
            ;;
        *)
            printf '%s' "/tmp/cache/$(util_cache_volatile_leaf)"
            ;;
    esac
}

util_fallback2_cache_dir() {
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    case "$(util_cache_host_kind)" in
        gitbash)
            printf '%s' ""
            ;;
        mac)
            printf '%s' "${HOME}/cache/$(util_cache_home_leaf)"
            ;;
        *)
            printf '%s' "${HOME}/.cache/$(util_cache_home_leaf)"
            ;;
    esac
}

# Create one cache tier. Silent on failure (caller tries the next tier).
util_cache_try_dir() {
    _cdir="${1:-}"
    [ -n "${_cdir}" ] || return 1
    _cparent=$(dirname "${_cdir}")
    case "${_cparent}" in
        /dev/shm/cache|/tmp/cache)
            mkdir -m 1777 -p "${_cparent}" 2>/dev/null || mkdir -p "${_cparent}" 2>/dev/null || return 1
            ;;
        *)
            mkdir -p "${_cparent}" 2>/dev/null || return 1
            ;;
    esac
    mkdir -m 0700 -p "${_cdir}" 2>/dev/null || mkdir -p "${_cdir}" 2>/dev/null || return 1
    [ -d "${_cdir}" ] && [ -w "${_cdir}" ] || return 1
    return 0
}

# Persistence storage (Type 0 durable per-user data).
# Path: ${HOME}/.local/${APP_NAME}
# MUST NOT be ${HOME}/.local/bin (install), /var/grok-cli (Type 1 deposit),
# or a ram-drive cache leaf.
util_persistent_storage_dir() {
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    printf '%s' "${HOME}/.local/${APP_NAME}"
}

# Create persistence storage before echo (fail-closed). Class B stdout.
util_resolve_persistent_storage() {
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    _persist=$(util_persistent_storage_dir)
    case "${_persist}" in
        */.local/bin|*/.local/bin/)
            out_die "Persistence storage must not be the install bin directory ${_persist}"
            ;;
    esac
    if ! mkdir -p "${_persist}" 2>/dev/null || [ ! -w "${_persist}" ]; then
        out_die "Cannot create persistence storage ${_persist}"
    fi
    echo "${_persist}"
    unset _persist
    return 0
}

# =============================================================================
# util_resolve_storage() - Cache folder resolver
# =============================================================================
#
# GENERAL PURPOSE:
# Returns the best available cache directory for scratch files.
# Linux: shm leaf, then /tmp leaf, then ${HOME}/.cache leaf.
# Git Bash: /tmp leaf, then AppData Local Temp leaf.
# Mac: /tmp leaf, then Library/Caches leaf, then ${HOME}/cache leaf.
# Volatile leaves are cache-${APP_NAME}-${login}-$$. Home leaves omit login.
# A missed tier is silent (no warning, no error). Error only if every tier fails.
# MUST NOT restore /dev/shm/${APP_NAME} or /dev/shm/${APP_NAME}-${USERNAME}.
#
# ECHO EXCEPTION (class B – function return-via-stdout):
# echo of cache paths is a data return for $(util_resolve_storage) capture,
# not a product user message. Failures use out_die.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Lessons Learned (CIAO Reflection):
# 2026-07-13: STORAGE_DIR was bare/unset on third fallback (INC-20260713-001 P1).
# 2026-07-16: Create chosen tier root before echo (fail-closed) for all tiers.
# 2026-08-30: Preferred cache moved under /dev/shm/cache/.
# 2026-09-27: Leaf is cache-${APP_NAME}-${login}-$$ so logins do not share
#             one directory. Tier misses stay silent.
#
# Last reviewed: 2026-09-27
# SSOT: requirement-shell-cli-storage.md
# =============================================================================
util_resolve_storage() {
    : "${USERNAME:=unknown}"
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"

    _storage_candidate=""
    if [ "${GROK_CLI_CACHE_SKIP:-}" != "preferred" ]; then
        _pref=$(util_preferred_cache_dir)
        if util_cache_try_dir "${_pref}"; then
            _storage_candidate="${_pref}"
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        _fb1=$(util_fallback_cache_dir)
        if util_cache_try_dir "${_fb1}"; then
            _storage_candidate="${_fb1}"
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        _fb2=$(util_fallback2_cache_dir)
        if [ -n "${_fb2}" ] && util_cache_try_dir "${_fb2}"; then
            _storage_candidate="${_fb2}"
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        out_die "Cannot create cache folder"
    fi
    echo "${_storage_candidate}"
    unset _storage_candidate _pref _fb1 _fb2
    return 0
}

# =============================================================================
# util_mktemp() - Isolated scratch file (consume EFFECTIVE_STORAGE_DIR)
# =============================================================================
# ALIGNMENT: requirement-shell-cli-storage.md
# Forbidden: predictable $$ names (e.g. /tmp/${APP_NAME}.$$).
# =============================================================================
util_mktemp() {
    : "${APP_NAME:=grok-cli}"
    : "${EFFECTIVE_STORAGE_DIR:=}"
    _suffix="${1:-tmp}"
    _dollar='$'
    case "${_suffix}" in
        *"${_dollar}${_dollar}"*)
            out_die "util_mktemp: refuse predictable \$\$ name template"
            ;;
    esac
    if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        export EFFECTIVE_STORAGE_DIR
    fi
    mktemp "${EFFECTIVE_STORAGE_DIR}/${APP_NAME}.${_suffix}.XXXXXX" 2>/dev/null \
        || mktemp "${TMPDIR:-/tmp}/${APP_NAME}.${_suffix}.XXXXXX" 2>/dev/null \
        || mktemp
}

# =============================================================================
# util_int_timer_*() - Named volatile internal-timer (process-scoped)
# =============================================================================
#
# GENERAL PURPOSE:
# Sibling-timer contracts as in-process named stages: start, stop, status,
# elapsed, reset, kill, list. State is UTIL_INT_TIMER_MAP (newline
# name=epoch). Lost on process exit. Not domain CLI verbs. Call stop /
# elapsed / reset bare — not $(util_int_timer_stop) — so this shell
# clears the map.
#
# ALIGNMENT:
# - requirement-shell-internal-volatile-timer.md
#
# Last updated: 2026-09-07
# =============================================================================
util_int_timer_now() {
    date +%s 2>/dev/null
}

util_int_timer_sanitize() {
    UTIL_INT_TIMER_NAME="${1:-}"
    [ -n "${UTIL_INT_TIMER_NAME}" ] || UTIL_INT_TIMER_NAME="default"
    # Allow-list only: case lookup uses "${name}="* as a glob, so [ ] would
    # match the wrong map record. Hyphen/dot keep logged-in and sudoers.*.
    case "${UTIL_INT_TIMER_NAME}" in
        *[!-._a-zA-Z0-9]*|..|*..*)
            out_debug "internal timer invalid name"
            return 1
            ;;
    esac
    return 0
}

util_int_timer_lookup() {
    UTIL_INT_TIMER_EPOCH=""
    : "${UTIL_INT_TIMER_NAME:=}"
    : "${UTIL_INT_TIMER_MAP:=}"
    [ -n "${UTIL_INT_TIMER_NAME}" ] || return 1
    [ -n "${UTIL_INT_TIMER_MAP}" ] || return 1
    while IFS= read -r _it_line || [ -n "${_it_line}" ]; do
        [ -n "${_it_line}" ] || continue
        case "${_it_line}" in
            "${UTIL_INT_TIMER_NAME}="*)
                UTIL_INT_TIMER_EPOCH="${_it_line#*=}"
                unset _it_line
                return 0
                ;;
        esac
    done <<EOF
${UTIL_INT_TIMER_MAP}
EOF
    unset _it_line
    return 1
}

util_int_timer_write() {
    : "${UTIL_INT_TIMER_NAME:=}"
    : "${UTIL_INT_TIMER_EPOCH:=}"
    : "${UTIL_INT_TIMER_MAP:=}"
    _it_new=""
    _it_found=0
    while IFS= read -r _it_line || [ -n "${_it_line}" ]; do
        [ -n "${_it_line}" ] || continue
        case "${_it_line}" in
            "${UTIL_INT_TIMER_NAME}="*)
                _it_new="${_it_new}${UTIL_INT_TIMER_NAME}=${UTIL_INT_TIMER_EPOCH}
"
                _it_found=1
                ;;
            *)
                _it_new="${_it_new}${_it_line}
"
                ;;
        esac
    done <<EOF
${UTIL_INT_TIMER_MAP}
EOF
    if [ "${_it_found}" -eq 0 ]; then
        _it_new="${_it_new}${UTIL_INT_TIMER_NAME}=${UTIL_INT_TIMER_EPOCH}
"
    fi
    UTIL_INT_TIMER_MAP="${_it_new}"
    unset _it_new _it_found _it_line
    return 0
}

util_int_timer_delete() {
    : "${UTIL_INT_TIMER_NAME:=}"
    : "${UTIL_INT_TIMER_MAP:=}"
    _it_new=""
    while IFS= read -r _it_line || [ -n "${_it_line}" ]; do
        [ -n "${_it_line}" ] || continue
        case "${_it_line}" in
            "${UTIL_INT_TIMER_NAME}="*)
                ;;
            *)
                _it_new="${_it_new}${_it_line}
"
                ;;
        esac
    done <<EOF
${UTIL_INT_TIMER_MAP}
EOF
    UTIL_INT_TIMER_MAP="${_it_new}"
    unset _it_new _it_line
    return 0
}

util_int_timer_fmt() {
    UTIL_INT_TIMER_LAST_ELAPSED="${1:-0}"
    UTIL_INT_TIMER_MINUTES=$((UTIL_INT_TIMER_LAST_ELAPSED / 60))
    UTIL_INT_TIMER_SECONDS=$((UTIL_INT_TIMER_LAST_ELAPSED % 60))
}

util_int_timer_start() {
    if ! util_int_timer_sanitize "${1:-}"; then
        return 1
    fi
    if util_int_timer_lookup; then
        out_debug "internal timer '${UTIL_INT_TIMER_NAME}' already running"
        return 1
    fi
    UTIL_INT_TIMER_EPOCH=$(util_int_timer_now) || return 1
    [ -n "${UTIL_INT_TIMER_EPOCH}" ] || return 1
    util_int_timer_write
    return 0
}

util_int_timer_stop() {
    if ! util_int_timer_sanitize "${1:-}"; then
        UTIL_INT_TIMER_LAST_ELAPSED=0
        return 1
    fi
    if ! util_int_timer_lookup; then
        out_debug "internal timer '${UTIL_INT_TIMER_NAME}' not running"
        UTIL_INT_TIMER_LAST_ELAPSED=0
        util_int_timer_fmt 0
        return 1
    fi
    _it_now=$(util_int_timer_now) || {
        unset _it_now
        UTIL_INT_TIMER_LAST_ELAPSED=0
        return 1
    }
    UTIL_INT_TIMER_LAST_ELAPSED=$((_it_now - UTIL_INT_TIMER_EPOCH))
    unset _it_now
    UTIL_INT_TIMER_LAST_NAME="${UTIL_INT_TIMER_NAME}"
    util_int_timer_fmt "${UTIL_INT_TIMER_LAST_ELAPSED}"
    util_int_timer_delete
    return 0
}

util_int_timer_status() {
    if ! util_int_timer_sanitize "${1:-}"; then
        UTIL_INT_TIMER_LAST_ELAPSED=0
        return 1
    fi
    if ! util_int_timer_lookup; then
        out_debug "internal timer '${UTIL_INT_TIMER_NAME}' not running"
        UTIL_INT_TIMER_LAST_ELAPSED=0
        util_int_timer_fmt 0
        return 1
    fi
    _it_now=$(util_int_timer_now) || {
        unset _it_now
        UTIL_INT_TIMER_LAST_ELAPSED=0
        return 1
    }
    UTIL_INT_TIMER_LAST_ELAPSED=$((_it_now - UTIL_INT_TIMER_EPOCH))
    unset _it_now
    UTIL_INT_TIMER_LAST_NAME="${UTIL_INT_TIMER_NAME}"
    util_int_timer_fmt "${UTIL_INT_TIMER_LAST_ELAPSED}"
    return 0
}

util_int_timer_elapsed() {
    util_int_timer_status "${1:-}"
}

util_int_timer_reset() {
    if ! util_int_timer_sanitize "${1:-}"; then
        return 1
    fi
    if ! util_int_timer_lookup; then
        out_debug "internal timer '${UTIL_INT_TIMER_NAME}' not running"
        return 1
    fi
    util_int_timer_delete
    UTIL_INT_TIMER_LAST_ELAPSED=0
    UTIL_INT_TIMER_LAST_NAME="${UTIL_INT_TIMER_NAME}"
    util_int_timer_fmt 0
    return 0
}

util_int_timer_kill() {
    util_int_timer_reset "${1:-}"
}

util_int_timer_list() {
    : "${UTIL_INT_TIMER_MAP:=}"
    UTIL_INT_TIMER_COUNT=0
    while IFS= read -r _it_line || [ -n "${_it_line}" ]; do
        [ -n "${_it_line}" ] || continue
        UTIL_INT_TIMER_COUNT=$((UTIL_INT_TIMER_COUNT + 1))
        out_debug "internal timer running ${_it_line%%=*}"
    done <<EOF
${UTIL_INT_TIMER_MAP}
EOF
    unset _it_line
    return 0
}

# Menu debug wrappers: never fail the list (reset-then-start / elapsed 0).
util_int_timer_debug_begin() {
    : "${DEBUG:=0}"
    [ "${DEBUG}" -eq 1 ] || return 0
    _it_stage="${1:-default}"
    if ! util_int_timer_start "${_it_stage}"; then
        util_int_timer_reset "${_it_stage}" || true
        util_int_timer_start "${_it_stage}" || true
    fi
    out_debug "menu step ${_it_stage}: start"
    unset _it_stage
    return 0
}

util_int_timer_debug_end() {
    : "${DEBUG:=0}"
    [ "${DEBUG}" -eq 1 ] || return 0
    _it_stage="${1:-default}"
    if util_int_timer_stop "${_it_stage}"; then
        out_debug "menu step ${_it_stage}: elapsed ${UTIL_INT_TIMER_LAST_ELAPSED}s (${UTIL_INT_TIMER_MINUTES} min ${UTIL_INT_TIMER_SECONDS} sec)"
    else
        util_int_timer_fmt 0
        out_debug "menu step ${_it_stage}: elapsed 0s (0 min 0 sec)"
    fi
    unset _it_stage
    return 0
}

# =============================================================================
# prompt_ask() - Defensive general-purpose interactive prompt with default
# =============================================================================
#
# GENERAL PURPOSE:
# Displays a message, shows current on its own line when set, and waits
# for user input. When a default is set, it is shown at the end of the
# prompt as [default]; Enter keeps that default.
# Fully respects --quiet, --json, and non-TTY environments.
# Uses the centralized output system (out_info / out_msg_n).
#
# This is the **Single Source of Truth** for all simple value prompts in the project.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Multiple guards prevent prompting in non-interactive contexts.
# - Intentional (Principle 2): Clear behavior for TTY vs non-TTY and quiet/JSON modes.
# - Anti-fragile (Principle 3): Works reliably across different terminals and invocation methods.
# - Over-protect (Principle 18): Trusts explicit INTERACTIVE=1 from caller when low-level TTY check is flaky.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Past AI assistants have repeatedly broken this by using raw printf/echo + read,
# which violates the single output system, quiet/json handling, and TTY detection.
#
# VALUE RETURN: assigns PROMPT_ASK_VALUE in the current shell.
# MUST NOT wrap prompt_ask in command substitution (T1-PROMPT-CAPTURE / INC-20260902-001).
# Prompt UI stays on out_info / out_msg_n. Do not replace those with raw printf + read.
# See requirement-shell-interactive-vs-noninteractive.md and
# requirement-shell-script-coding.md.
#
# Last updated: 2026-09-07
# =============================================================================

prompt_ask() {
    # --- Safe Variable Defaults ---
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${PROMPT_ASK_VALUE:=}"

    # set -u safe: missing args become empty defaults (INC-20260713-001 class)
    local message="${1-}"
    local default="${2-}"
    local current="${3-}"

    PROMPT_ASK_VALUE="${default}"

    # Never prompt in non-interactive modes
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    # Consume TTY SSOT (measured outside functions). Do not re-test [ -t.
    if [ "${TTY:-0}" -ne 1 ]; then
        if [ "${INTERACTIVE:-0}" -ne 1 ]; then
            return 0
        fi
    fi

    if [ -n "${current}" ]; then
        out_info "Current: ${current}"
    fi
    if [ -n "${default}" ]; then
        out_msg_n "${message} [${default}]: "
    else
        out_msg_n "${message}: "
    fi

    local answer=""
    read -r answer || true

    if [ -n "${answer}" ]; then
        PROMPT_ASK_VALUE="${answer}"
    fi
    return 0
}

# =============================================================================
# prompt_yes_no() - Defensive interactive yes/no confirmation prompt
# =============================================================================
#
# GENERAL PURPOSE:
# Displays a message and waits for (y/N) confirmation.
# Returns 0 if user says yes, returns 1 (non-zero) if user says no or cancels.
#
# CRITICAL DEFENSIVE RULES (DO NOT VIOLATE):
# 1. Must ALWAYS go through single source of truth (out_msg_n + out_text)
# 2. Must respect --quiet and --json (never show prompt in those modes)
# 3. Must NEVER use raw printf/echo for user-visible prompt text (product UI)
#    (class-B return-via-stdout does not apply here — this helper uses exit status)
# 4. Must work correctly in non-interactive / curl | sh environments
# 5. Must preserve TTY detection and color handling via out_text
# 6. This is the SINGLE SOURCE OF TRUTH for all yes/no confirmations in the project.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Past AI assistants have repeatedly replaced this kind of prompt with
# raw printf + read, breaking consistency with out_text(), --quiet,
# --json, TTY detection, and the overall defensive design.
#
# This helper exists specifically to prevent that regression and to enforce
# CIAO-Lite principles of Caution, Intentionality, and Over-protect.
#
# Last reviewed: 29 April 2026
# =============================================================================

prompt_yes_no() {
    # --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    : "${JSON:=0}"
    : "${QUIET:=0}"

    local message="$1"

    # Never show prompt in quiet or json mode
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        return 1   # treat as "no" in non-interactive modes
    fi

    # Consume TTY SSOT (measured outside functions). Do not re-test [ -t.
    if [ "${TTY:-0}" -ne 1 ]; then
        return 1
    fi

    out_msg_n "${message} (y/N)? "

    local answer=""
    read -r answer || true

    case "$answer" in
        [Yy]*|[Yy][Ee][Ss]*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


