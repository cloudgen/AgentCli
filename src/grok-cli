# =============================================================================
# app_default() - Default interaction: TTY numbered menu / off-TTY help
# =============================================================================
#
# GENERAL PURPOSE:
# Command menu / main / TTY empty argv. On a real terminal: ignore --json on
# menu/main, show the numbered list, run one pick (or open the sudoers submenu).
# An invalid pick out_error + reprints this layer (MUST NOT out_die).
# Off-TTY: help (JSON help when --json). Never hang.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-09-26
# =============================================================================
app_default() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=grok-cli}"

    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET

    while true; do
        app_default_print_menu
        gc_menu_prompt
        _pick=""
        if ! read -r _pick; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
        esac
        if gc_menu_pick_is_family "grok-auth" "${_pick}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            if app_default_auth_loop; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        if gc_menu_pick_is_family "sudoers" "${_pick}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            if app_default_sudoers_loop; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        if gc_menu_pick_is_family "self-management" "${_pick}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            if app_default_self_loop; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        if gc_menu_pick_is_family "language" "${_pick}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            if app_default_language_loop; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_pick "${_pick}"; then
            return 0
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        if gc_host_is_normal_user_only; then
            gc_menu_bad "${_pick}" "1, 2, 6, 7, or 9 to leave"
        else
            gc_menu_bad "${_pick}" "1, 5, 6, 7, or 9 to leave"
        fi
    done
}

