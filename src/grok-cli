# gc_menu_row_match() - Print the token when pick is its number or name
# =============================================================================
gc_menu_row_match() {
    _m_pick="${1-}"
    _m_found=""
    while read -r _m_num _m_tok; do
        [ -n "${_m_num}" ] || continue
        if [ -z "${_m_found}" ]; then
            if [ "${_m_pick}" = "${_m_num}" ] || [ "${_m_pick}" = "${_m_tok}" ]; then
                _m_found="${_m_tok}"
            fi
        fi
    done
    if [ -n "${_m_found}" ]; then
        printf '%s' "${_m_found}"
        unset _m_pick _m_found _m_num _m_tok
        return 0
    fi
    unset _m_pick _m_found _m_num _m_tok
    return 1
}

