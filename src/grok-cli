# =============================================================================
# app_about() - Diagnostics (local-only; no channel one-liner)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-domain-grok-cli.md (about domain fields)
# - requirement-grok-setup.md (grok_peer)
# - requirement-shell-cli-storage.md
#
# Last updated: 2026-08-30
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=1.0.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=grok-cli}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _cache_preferred=$(util_preferred_cache_dir)
    _cache_fallback=$(util_fallback_cache_dir)
    _cache_fallback_2=$(util_fallback2_cache_dir)
    STORAGE_DIR="${_cache_fallback}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    fi

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    # Best-effort sudo deposit probe
    _sudo_deposit="unknown"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _sudo_deposit="root"
    elif command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            _sudo_deposit="sudo_n_ok"
        else
            _sudo_deposit="sudo_needs_auth_or_denied"
        fi
    else
        _sudo_deposit="no_sudo"
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(gc_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(gc_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
    fi
    _sudoer_inbound="not_found"
    _sudoer_inbound_writable="false"
    if _sin_path=$(gc_detect_sudoer_inbound); then
        _sudoer_inbound="${_sin_path}"
        if [ -w "${_sin_path}" ]; then
            _sudoer_inbound_writable="true"
        fi
    fi

    _host_sudoers_present="false"
    _host_sudoers_path=""
    if _hsp=$(gc_probe_current_user_host_sudoers); then
        _host_sudoers_present="true"
        _host_sudoers_path="${_hsp}"
    fi

    _grok_peer_json=$(gc_resolve_grok_peer)
    [ -n "${_grok_peer_json}" ] || _grok_peer_json="not_found"

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "cache_used" "${EFFECTIVE_STORAGE_DIR}" \
            "cache_preferred" "${_cache_preferred}" \
            "cache_fallback" "${_cache_fallback}" \
            "cache_fallback_2" "${_cache_fallback_2}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "grok_home" "$(gc_resolve_grok_home)" \
            "grok_cli_root" "${GROK_CLI_ROOT}" \
            "deposit_dir" "${GROK_CLI_ROOT}" \
            "session" "$(gc_session_status_word 2>/dev/null || echo missing)" \
            "sudo_deposit" "${_sudo_deposit}" \
            "sudoers_trust_tier" "$(gc_sudoers_trust_tier)" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "host_sudoers_present" "${_host_sudoers_present}" \
            "host_sudoers_path" "${_host_sudoers_path}" \
            "grok_peer" "${_grok_peer_json}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    case "${APP_LANG:-en}" in
        en) ;;
        *)
            app_about_i18n
            return 0
            ;;
    esac

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    _tier=$(gc_sudoers_trust_tier)
    out_info "Sudoers trust tier: ${_tier}  (production requires global; local-only = test mode)"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 + narrow Type 1 deposit)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Cache folder used: ${EFFECTIVE_STORAGE_DIR}"
    out_info "Cache folder (preferred): ${_cache_preferred}"
    out_info "Cache folder (1st fallback): ${_cache_fallback}"
    if [ -n "${_cache_fallback_2}" ]; then
        out_info "Cache folder (2nd fallback): ${_cache_fallback_2}"
    fi
    out_info "Persistence storage:      ${PERSISTENT_STORAGE_DIR}"
    out_empty_line
    _grok_peer=$(gc_resolve_grok_peer)
    if [ -n "${_grok_peer}" ]; then
        out_info "Grok CLI (xAI):    ${_grok_peer}"
    else
        out_info "Grok CLI (xAI):    not found — ${APP_NAME} setup installs it"
    fi
    out_info "Grok home:         $(gc_resolve_grok_home)"
    out_info "Session:           $(gc_session_status_word 2>/dev/null || echo missing)"
    out_info "Deposit directory: ${GROK_CLI_ROOT}"
    out_info "Sudo deposit:      ${_sudo_deposit}"
    out_info "sudoer-cli:        ${_sudoer_cli}"
    out_info "sudoer-adm:        ${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "sudoer inbound:    not_found (preferred ${SUDOER_PUBLIC_ROOT:-/var/sudoer-cli}/sudoer-request)"
    else
        out_info "sudoer inbound:    ${_sudoer_inbound} (writable=${_sudoer_inbound_writable})"
    fi
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} menu            → Numbered list of live commands (real terminal)"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   ${APP_NAME} print-sudoers   → Sudoers fragment for admin"
    out_info "   ${APP_NAME} generate-sudoer-request → Write a local JSON grant you can verify"
    out_info "   ${APP_NAME} submit-sudoer-request → JSON request into /var/sudoer-cli/sudoer-request"
    out_info "   ${APP_NAME} check-session   → Confirm grok is logged in (grok -p hello)"
    out_info "   ${APP_NAME} backup          → Push ~/.grok/auth.* to /var/grok-cli (sudo grant)"
    out_info "   ${APP_NAME} sync-auth       → Copy /var/grok-cli/auth.* into ~/.grok (no sudo)"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
