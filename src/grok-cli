inst_channel_ensure() {
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${JSON:=0}"
    if inst_is_installed && [ "${FORCE_REINSTALL}" -ne 1 ] && [ "${FORCE}" -ne 1 ]; then
