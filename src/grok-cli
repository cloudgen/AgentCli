# =============================================================================
# ver_check() - Local vs remote VERSION on SCRIPT_URL
# =============================================================================
#
# ALIGNMENT: requirement-shell-self-management.md
# Last updated: 2026-09-02
# =============================================================================
ver_check() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${SCRIPT_URL:=}"
    REMOTE_VERSION=$(util_fetch_remote_version "${SCRIPT_URL}") || REMOTE_VERSION=""
    if [ -z "${REMOTE_VERSION}" ]; then
        out_die "Failed to fetch remote version from ${SCRIPT_URL}. Next: check network, then ${APP_NAME} version-check."
    fi
    _vc_local=$(inst_get_version)
    _vc_latest="false"
    if [ "${_vc_local}" = "${REMOTE_VERSION}" ]; then
        _vc_latest="true"
    elif ver_gt "${_vc_local}" "${REMOTE_VERSION}" 2>/dev/null; then
        _vc_latest="true"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "ver_check" "" \
            "local_version" "${_vc_local}" \
            "remote_version" "${REMOTE_VERSION}" \
            "is_latest" "${_vc_latest}"
        return 0
    fi
    out_info "Checking latest version of ${APP_NAME}..."
    out_plain "Local version : ${_vc_local}"
    out_plain "Latest version: ${REMOTE_VERSION}"
    if [ "${_vc_local}" = "${REMOTE_VERSION}" ]; then
        out_success "You are running the latest version."
    elif ver_gt "${_vc_local}" "${REMOTE_VERSION}" 2>/dev/null; then
        out_success "You are running a newer development version (${_vc_local} > ${REMOTE_VERSION})"
    elif [ "${_vc_local}" = "not installed" ]; then
        out_warn "${APP_NAME} is not installed yet."
    else
        out_warn "A newer version is available (${REMOTE_VERSION})"
    fi
    return 0
}

# =============================================================================
# inst_self_update() - Channel re-download when remote is newer (or --force)
# =============================================================================
#
# ALIGNMENT: requirement-shell-self-management.md · requirement-grok-setup.md
# Last updated: 2026-09-07
# =============================================================================
inst_self_update() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    : "${SCRIPT_URL:=}"
    if [ "${FORCE}" -eq 1 ]; then
        FORCE_REINSTALL=1
    fi
    REMOTE_VERSION=$(util_fetch_remote_version "${SCRIPT_URL}") || REMOTE_VERSION=""
    if [ -z "${REMOTE_VERSION}" ]; then
        out_die "Failed to fetch remote version from ${SCRIPT_URL}. Next: check network, then ${APP_NAME} self-update."
    fi
    _isu_local=$(inst_get_version)
    if [ "${FORCE}" -ne 1 ] && [ "${_isu_local}" != "not installed" ]; then
        if [ "${_isu_local}" = "${REMOTE_VERSION}" ]; then
            out_success "${APP_NAME} is already at ${REMOTE_VERSION}."
            _isu_peer=$(gc_resolve_grok_peer)
            if [ -n "${_isu_peer}" ]; then
                gc_setup_heal_android_wrapper "${_isu_peer}"
            fi
            unset _isu_local _isu_peer
            return 0
        fi
        if ver_gt "${_isu_local}" "${REMOTE_VERSION}" 2>/dev/null; then
            out_die "Local ${_isu_local} is newer than remote ${REMOTE_VERSION}. Next: ${APP_NAME} self-update --force to replace anyway."
        fi
    fi
    out_info "Starting the self-update of ${APP_NAME}(${_isu_local}) to new version:${REMOTE_VERSION}..."
    FORCE_REINSTALL=1
    inst_perform_channel_install
    _isu_peer=$(gc_resolve_grok_peer)
    if [ -n "${_isu_peer}" ]; then
        gc_setup_heal_android_wrapper "${_isu_peer}"
    fi
    unset _isu_local _isu_peer
}

