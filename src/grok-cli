app_default_language_code() {
    case "${1-}" in
        80|en|english|English) printf '%s' "en" ;;
        81|zh-Hans|zh-hans|simplified-chinese|简体中文) printf '%s' "zh-Hans" ;;
        82|zh-Hant|zh-hant|traditional-chinese|繁體中文) printf '%s' "zh-Hant" ;;
        83|es|spanish|Español|español) printf '%s' "es" ;;
        84|ar|arabic|العربية|عربي) printf '%s' "ar" ;;
        85|fr|french|Français|français) printf '%s' "fr" ;;
        86|pt|portuguese|Português|português|portugues) printf '%s' "pt" ;;
        87|ru|russian|Русский|русский) printf '%s' "ru" ;;
        88|de|german|Deutsch|deutsch) printf '%s' "de" ;;
        89|ja|japanese|日本語) printf '%s' "ja" ;;
        90|ko|korean|한국어) printf '%s' "ko" ;;
        91|nl|dutch|Nederlands|nederlands) printf '%s' "nl" ;;
        92|el|greek|Ελληνικά|ελληνικά) printf '%s' "el" ;;
        *) return 1 ;;
    esac
}

app_default_language_loop() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_default_print_language_menu
        gc_menu_prompt
        _pick=""
        if ! read -r _pick; then
            return 0
        fi
        case "${_pick}" in
            0|q|back|Back|"")
                return 1
                ;;
            9|99|exit|quit|Exit|QUIT)
                return 0
                ;;
        esac
        _code=$(app_default_language_code "${_pick}" || true)
        if [ -n "${_code}" ]; then
            if app_lang_save "${_code}"; then
                out_info "$(app_menu_text lang_saved)"
            else
                out_warn "$(app_menu_text lang_save_fail)"
            fi
            unset _code
            return 1
        fi
        unset _code
        gc_menu_bad "${_pick}" "80-92, 0 back, 9 to leave"
    done
}

