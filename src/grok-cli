# =============================================================================
# gc_setup_detect_platform() - Class B: print os-arch (linux-aarch64, …)
# =============================================================================
#
# GENERAL PURPOSE:
# Same OS/arch map as the studied xAI installer (Darwin→macos, Linux→linux;
# MINGW/MSYS/CYGWIN → windows; x86_64/amd64, aarch64/arm64; macOS Rosetta
# → aarch64). Empty + return 1 when unsupported. Native Windows cmd /
# PowerShell stay out of this POSIX ship unit (use install.ps1).
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-10
# =============================================================================
gc_setup_detect_platform() {
    _sys=$(uname -s 2>/dev/null) || _sys=""
    _mach=$(uname -m 2>/dev/null) || _mach=""
    case "${_sys}" in
        Darwin) _os="macos" ;;
        Linux)  _os="linux" ;;
        MINGW*|MSYS*|CYGWIN*) _os="windows" ;;
        *)
            printf ''
            return 1
            ;;
    esac
    case "${_mach}" in
        x86_64|amd64|AMD64) _arch="x86_64" ;;
        arm64|aarch64|ARM64) _arch="aarch64" ;;
        *)
            printf ''
            return 1
            ;;
    esac
    if [ "${_os}" = "macos" ] && [ "${_arch}" = "x86_64" ]; then
        _sysctl=$(command -v sysctl 2>/dev/null || echo /usr/sbin/sysctl)
        if [ "$("${_sysctl}" -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
            _arch="aarch64"
        fi
    fi
    printf '%s-%s' "${_os}" "${_arch}"
    return 0
}

# =============================================================================
# gc_setup_elf_arch() - Class B: print x86_64 / aarch64 from ELF e_machine
# =============================================================================
#
# GENERAL PURPOSE:
# Read ELF magic and e_machine (offset 18, little-endian u16) so setup can
# refuse a linux-x86_64 grok on aarch64 Termux before exec. Empty + return 1
# when the file is not ELF, od/dd cannot read it, or the machine is unknown.
# Scripts used in Core tests are not ELF — callers MUST treat empty as
# "skip this check", not as a match.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_elf_arch() {
    _gea_file="${1:-}"
    if [ -z "${_gea_file}" ] || [ ! -f "${_gea_file}" ]; then
        printf ''
        return 1
    fi
    if ! command -v od >/dev/null 2>&1; then
        printf ''
        return 1
    fi
    _gea_magic=$(od -An -N 4 -t x1 "${_gea_file}" 2>/dev/null | tr -d ' \n\t' | tr 'A-F' 'a-f')
    if [ "${_gea_magic}" != "7f454c46" ]; then
        printf ''
        return 1
    fi
    _gea_mach=$(od -An -N 2 -j 18 -t u2 "${_gea_file}" 2>/dev/null | tr -d ' \n\t')
    if [ -z "${_gea_mach}" ] && command -v dd >/dev/null 2>&1; then
        _gea_mach=$(dd if="${_gea_file}" bs=1 skip=18 count=2 2>/dev/null | od -An -t u2 | tr -d ' \n\t')
    fi
    case "${_gea_mach}" in
        62) printf 'x86_64' ;;
        183) printf 'aarch64' ;;
        *)
            printf ''
            return 1
            ;;
    esac
    return 0
}

# =============================================================================
# gc_setup_peer_usable() - 0 if existing grok can run on this host
# =============================================================================
#
# GENERAL PURPOSE:
# Skip setup only when the peer is actually usable here. An x86_64 ELF
# copied onto aarch64 Termux is executable-bit-on and must not count as
# already_installed. Prefer ELF e_machine over exec when both are known
# so Termux does not print EM_X86_64 during the probe.
#
# $1 = peer path; $2 = host arch (x86_64 / aarch64, may be empty).
# Sets GC_SETUP_PEER_UNUSABLE on failure.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_peer_usable() {
    _gpu_peer="${1:-}"
    _gpu_host_arch="${2:-}"
    GC_SETUP_PEER_UNUSABLE=""
    if [ -z "${_gpu_peer}" ] || [ ! -x "${_gpu_peer}" ]; then
        GC_SETUP_PEER_UNUSABLE="not executable"
        return 1
    fi
    _gpu_elf=$(gc_setup_elf_arch "${_gpu_peer}") || _gpu_elf=""
    if [ -n "${_gpu_elf}" ] && [ -n "${_gpu_host_arch}" ] && [ "${_gpu_elf}" != "${_gpu_host_arch}" ]; then
        GC_SETUP_PEER_UNUSABLE="${_gpu_elf} ELF, this host is ${_gpu_host_arch}"
        return 1
    fi
    if gc_setup_smoke_version "${_gpu_peer}"; then
        return 0
    fi
    GC_SETUP_PEER_UNUSABLE="failed --version"
    if [ -n "${GC_SETUP_SMOKE_DETAIL:-}" ]; then
        GC_SETUP_PEER_UNUSABLE="${GC_SETUP_PEER_UNUSABLE} (${GC_SETUP_SMOKE_DETAIL})"
    fi
    return 1
}

# =============================================================================
# gc_setup_curl_file() - curl URL into a file; 0 only when HTTP 200 and non-empty
# =============================================================================
#
# GENERAL PURPOSE:
# Fetch one URL into a dest file. Record GC_SETUP_CURL_HTTP and
# GC_SETUP_CURL_DETAIL so setup errors can name HTTP 404 / HTTP 000
# instead of only "check network". Does not use curl -f, so the
# status code is still available on 4xx/5xx.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_curl_file() {
    _gcf_url="${1:-}"
    _gcf_out="${2:-}"
    GC_SETUP_CURL_HTTP=""
    GC_SETUP_CURL_DETAIL=""
    if [ -z "${_gcf_url}" ] || [ -z "${_gcf_out}" ]; then
        GC_SETUP_CURL_DETAIL="missing URL or dest"
        return 1
    fi
    GC_SETUP_CURL_URL="${_gcf_url}"
    _gcf_ec=0
    _gcf_code=$(curl -sS -L -o "${_gcf_out}" -w '%{http_code}' "${_gcf_url}" 2>/dev/null) || _gcf_ec=$?
    GC_SETUP_CURL_HTTP="${_gcf_code}"
    if [ "${_gcf_ec}" -ne 0 ]; then
        if [ -n "${_gcf_code}" ] && [ "${_gcf_code}" != "000" ]; then
            GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code} (curl exit ${_gcf_ec})"
        else
            GC_SETUP_CURL_DETAIL="HTTP 000 (curl exit ${_gcf_ec})"
        fi
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ -z "${_gcf_code}" ]; then
        GC_SETUP_CURL_DETAIL="curl returned no HTTP status"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ "${_gcf_code}" != "200" ]; then
        GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code}"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ ! -s "${_gcf_out}" ]; then
        GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code} empty body"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    unset _gcf_url _gcf_out _gcf_code _gcf_ec
    return 0
}

# =============================================================================
# gc_setup_read_pointer() - set GC_SETUP_POINTER from channel (same shell)
# =============================================================================
gc_setup_read_pointer() {
    _grp_channel="${1:-stable}"
    GC_SETUP_POINTER=""
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    _grp_tmp=$(util_mktemp ptr)
    if [ -z "${_grp_tmp}" ]; then
        return 1
    fi
    for _grp_base in "${GROK_VENDOR_BASE_URL}" "${GROK_VENDOR_FALLBACK_URL}"; do
        if gc_setup_curl_file "${_grp_base}/${_grp_channel}" "${_grp_tmp}"; then
            _grp_ver=$(tr -d '\r' < "${_grp_tmp}" | head -n1 | tr -d '[:space:]')
            if gc_setup_version_ok "${_grp_ver}"; then
                rm -f "${_grp_tmp}"
                GC_SETUP_POINTER="${_grp_ver}"
                unset _grp_channel _grp_tmp _grp_base _grp_ver
                return 0
            fi
            GC_SETUP_CURL_DETAIL="HTTP ${GC_SETUP_CURL_HTTP:-?} invalid version pointer"
        fi
    done
    rm -f "${_grp_tmp}"
    unset _grp_channel _grp_tmp _grp_base _grp_ver
    return 1
}

# =============================================================================
# gc_setup_fetch_binary_from() - one artifact base (.zst / .gz / raw) → dest
# =============================================================================
gc_setup_fetch_binary_from() {
    _gfb_art="${1:-}"
    _gfb_dest="${2:-}"
    _gfb_tmp=$(util_mktemp setupz)
    if [ -z "${_gfb_tmp}" ]; then
        return 1
    fi
    if command -v zstd >/dev/null 2>&1; then
        if gc_setup_curl_file "${_gfb_art}.zst" "${_gfb_tmp}"; then
            if zstd -q -dc < "${_gfb_tmp}" > "${_gfb_dest}" 2>/dev/null && [ -s "${_gfb_dest}" ]; then
                rm -f "${_gfb_tmp}"
                return 0
            fi
        fi
        rm -f "${_gfb_dest}"
    fi
    if command -v gzip >/dev/null 2>&1; then
        if gc_setup_curl_file "${_gfb_art}.gz" "${_gfb_tmp}"; then
            if gzip -dc < "${_gfb_tmp}" > "${_gfb_dest}" 2>/dev/null && [ -s "${_gfb_dest}" ]; then
                rm -f "${_gfb_tmp}"
                return 0
            fi
        fi
        rm -f "${_gfb_dest}"
    fi
    rm -f "${_gfb_tmp}"
    if gc_setup_curl_file "${_gfb_art}" "${_gfb_dest}"; then
        return 0
    fi
    rm -f "${_gfb_dest}"
    return 1
}

# =============================================================================
# gc_setup_fetch_artifact() - primary then fallback bases
# =============================================================================
gc_setup_fetch_artifact() {
    _gfa_version="${1:-}"
    _gfa_platform="${2:-}"
    _gfa_dest="${3:-}"
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    for _gfa_base in "${GROK_VENDOR_BASE_URL}" "${GROK_VENDOR_FALLBACK_URL}"; do
        case "${_gfa_platform}" in
            windows-*)
                if gc_setup_fetch_binary_from "${_gfa_base}/grok-${_gfa_version}-${_gfa_platform}.exe" "${_gfa_dest}"; then
                    return 0
                fi
                if gc_setup_fetch_binary_from "${_gfa_base}/grok-${_gfa_version}-${_gfa_platform}" "${_gfa_dest}"; then
                    return 0
                fi
                ;;
            *)
                if gc_setup_fetch_binary_from "${_gfa_base}/grok-${_gfa_version}-${_gfa_platform}" "${_gfa_dest}"; then
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

# =============================================================================
# gc_setup_place_links() - downloads file + relative grok/agent symlinks
# =============================================================================
gc_setup_place_links() {
    _gpl_src="${1:-}"
    _gpl_download_dir="${2:-}"
    _gpl_bin_dir="${3:-}"
    _gpl_platform="${4:-}"
    _gpl_final="${_gpl_download_dir}/grok-${_gpl_platform}"
    mkdir -p "${_gpl_download_dir}" "${_gpl_bin_dir}" || return 1
    mv -f "${_gpl_src}" "${_gpl_final}" || return 1
    chmod 0755 "${_gpl_final}" || return 1
    if [ "$(dirname "${_gpl_bin_dir}")" = "$(dirname "${_gpl_download_dir}")" ]; then
        _gpl_link="../$(basename "${_gpl_download_dir}")/$(basename "${_gpl_final}")"
    else
        _gpl_link="${_gpl_final}"
    fi
    ln -sf "${_gpl_link}" "${_gpl_bin_dir}/grok" || return 1
    ln -sf "${_gpl_link}" "${_gpl_bin_dir}/agent" || return 1
    return 0
}

# =============================================================================
# gc_setup_place_windows_exe() - downloads .exe + copy grok.exe / agent.exe
# =============================================================================
#
# GENERAL PURPOSE:
# Git Bash / MSYS / Cygwin use the windows-* PE (studied install.sh).
# Symlinks need Developer Mode; copy like install.sh / install.ps1.
# If grok.exe is locked, rename aside then copy; rollback on fail.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-10
# =============================================================================
gc_setup_place_windows_exe() {
    _gpw_src="${1:-}"
    _gpw_download_dir="${2:-}"
    _gpw_bin_dir="${3:-}"
    _gpw_platform="${4:-}"
    _gpw_final="${_gpw_download_dir}/grok-${_gpw_platform}.exe"
    mkdir -p "${_gpw_download_dir}" "${_gpw_bin_dir}" || return 1
    mv -f "${_gpw_src}" "${_gpw_final}" || return 1
    chmod 0755 "${_gpw_final}" || return 1
    for _gpw_name in grok.exe agent.exe; do
        _gpw_dest="${_gpw_bin_dir}/${_gpw_name}"
        rm -f "${_gpw_dest}.old" 2>/dev/null || true
        if ! cp -f "${_gpw_final}" "${_gpw_dest}" 2>/dev/null; then
            mv -f "${_gpw_dest}" "${_gpw_dest}.old" 2>/dev/null || true
            if ! cp -f "${_gpw_final}" "${_gpw_dest}" 2>/dev/null; then
                mv -f "${_gpw_dest}.old" "${_gpw_dest}" 2>/dev/null || true
                return 1
            fi
        fi
        chmod 0755 "${_gpw_dest}" 2>/dev/null || true
    done
    return 0
}

# =============================================================================
# gc_setup_path_symlink() - link into a writable PATH dir (USER_BIN, GLOBAL_BIN, PREFIX)
# =============================================================================
gc_setup_path_symlink() {
    _gps_bin_dir="${1:-}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    for _gps_cand in "${USER_BIN}" "${GLOBAL_BIN}" ${PREFIX:+"${PREFIX}/bin"}; do
        [ -n "${_gps_cand}" ] || continue
        if gc_setup_path_has_dir "${_gps_cand}" && [ -d "${_gps_cand}" ] && [ -w "${_gps_cand}" ]; then
            ln -sf "${_gps_bin_dir}/grok" "${_gps_cand}/grok" 2>/dev/null || true
            ln -sf "${_gps_bin_dir}/agent" "${_gps_cand}/agent" 2>/dev/null || true
            return 0
        fi
    done
    return 0
}

