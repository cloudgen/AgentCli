# =============================================================================
# inst_get_version() - Extract version from installed binary
# =============================================================================
#
# GENERAL PURPOSE:
# Safely reads the VERSION constant from the installed script.
# Used by about / install diagnostics (local Type 0). Not a remote version-check.
#
# Safe Variable Defaults
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Designed to be reusable in other projects.
#
# CRITICAL: installed-version extraction must stay grep '^VERSION="' + cut.
# about/install compare managed binaries this way. Do not invent a parser.
#
# PRINTF/ECHO EXCEPTION (class B – function return-via-stdout):
# echo "unknown" / echo "not installed" / grep|cut pipeline output are data
# returns for $(inst_get_version) capture — not product banners. Callers
# pass the string into out_* / out_json when displaying to the user.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Last reviewed: 2026-07-12
# =============================================================================

inst_get_version() {
    # --- Safe Variable Defaults ----
    # Align with util_get_install_bin_path: non-root prefers user-local when present (L-03).
    : "${APP_NAME:=app}"
    : "${IS_ROOT:=0}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE_USER:=0}"
    : "${FORCE_GLOBAL:=0}"

    local bin_path=""
    if [ "${FORCE_USER}" -eq 1 ]; then
        bin_path="${USER_BIN}/${APP_NAME}"
    elif [ "${FORCE_GLOBAL}" -eq 1 ] || [ "${IS_ROOT}" -eq 1 ] || [ "$(id -u)" -eq 0 ]; then
        bin_path="${GLOBAL_BIN}/${APP_NAME}"
    else
        if [ -x "${USER_BIN}/${APP_NAME}" ]; then
            bin_path="${USER_BIN}/${APP_NAME}"
        elif [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            bin_path="${GLOBAL_BIN}/${APP_NAME}"
        else
            bin_path="${USER_BIN}/${APP_NAME}"
        fi
    fi

    if [ -x "$bin_path" ]; then
        grep '^VERSION="' "$bin_path" 2>/dev/null | cut -d'"' -f2 || echo "unknown"
    else
        echo "not installed"
    fi
}

path_add_bashrc() {
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${BASHRC:=${HOME}/.bashrc}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=0}"
    : "${JSON:=0}"
    local bashrc="${BASHRC}"
    local path_line
    local created=0
    local comment
    path_line=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")
    comment=$(printf '# Added by %s installer (%s)' "${APP_NAME}" "${VERSION}")

    if [ ! -f "$bashrc" ]; then
        if ! printf '# Interactive rc created by %s installer (%s)\n' "$APP_NAME" "$VERSION" > "$bashrc"; then
            if [ "${JSON}" -eq 0 ]; then
                out_warn "Could not create ${bashrc}. Next: create that file as this login, then re-run ${APP_NAME} install."
            fi
            return 1
        fi
        chmod 0644 "$bashrc" 2>/dev/null || true
        created=1
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Created ${bashrc}"
        fi
    fi

    if ! grep -qF "${path_line}" "$bashrc" 2>/dev/null; then
        printf "\n%s\n" "${comment}" >> "$bashrc"
        printf '%s\n' "${path_line}" >> "$bashrc"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Added ${USER_BIN} to PATH for bash"
        fi
        return 0
    fi
    if ! grep -qF "${comment}" "$bashrc" 2>/dev/null; then
        printf "\n%s\n" "${comment}" >> "$bashrc"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Noted ${APP_NAME} installer on bash PATH"
        fi
        return 0
    fi
    if [ "$created" -eq 1 ]; then
        return 0
    fi
    return 1
}

# =============================================================================
# path_add_zshenv() - Add ~/.local/bin to ~/.zshenv
# =============================================================================
#
# GENERAL PURPOSE:
# Appends the PATH export to ~/.zshenv (always-on zsh rc), not ~/.zshrc.
# Creates the file when zsh environment is detected or ZSHENV is set.
# Does not invent ${HOME}/.zshenv for a bash-only login with no override.
#
# ALIGNMENT: requirement-shell-zshenv.md
# Last reviewed: 2026-09-17
# =============================================================================

path_add_zshenv() {
    _pae_explicit=0
    if [ -n "${ZSHENV+x}" ]; then
        _pae_explicit=1
    fi
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${ZSHENV:=${HOME}/.zshenv}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=0}"
    : "${JSON:=0}"
    _pae_zshenv="${ZSHENV}"
    _pae_path=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")
    _pae_comment=$(printf '# Added by %s installer (%s)' "${APP_NAME}" "${VERSION}")
    _pae_zsh_shell=0
    case "$(basename "${SHELL:-}")" in
        zsh) _pae_zsh_shell=1 ;;
    esac
    _pae_created=0

    if [ ! -f "${_pae_zshenv}" ]; then
        if [ "${_pae_explicit}" -eq 0 ] && [ "${_pae_zsh_shell}" -eq 0 ]; then
            unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
            return 1
        fi
        if ! printf '# Always-on zsh rc created by %s installer (%s)\n' "${APP_NAME}" "${VERSION}" > "${_pae_zshenv}"; then
            if [ "${JSON}" -eq 0 ]; then
                out_warn "Could not create ${_pae_zshenv}. Next: create that file as this login, then re-run ${APP_NAME} install."
            fi
            unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
            return 1
        fi
        chmod 0644 "${_pae_zshenv}" 2>/dev/null || true
        _pae_created=1
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Created ${_pae_zshenv}"
        fi
    fi

    if ! grep -qF "${_pae_path}" "${_pae_zshenv}" 2>/dev/null; then
        printf "\n%s\n" "${_pae_comment}" >> "${_pae_zshenv}"
        printf '%s\n' "${_pae_path}" >> "${_pae_zshenv}"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Added ${USER_BIN} to PATH for zsh (.zshenv)"
        fi
        unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
        return 0
    fi
    if ! grep -qF "${_pae_comment}" "${_pae_zshenv}" 2>/dev/null; then
        printf "\n%s\n" "${_pae_comment}" >> "${_pae_zshenv}"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Noted ${APP_NAME} installer on zsh PATH"
        fi
        unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
        return 0
    fi
    if [ "${_pae_created}" -eq 1 ]; then
        unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
        return 0
    fi
    unset _pae_explicit _pae_zshenv _pae_path _pae_comment _pae_zsh_shell _pae_created
    return 1
}

# path_add_zshrc is unused for PATH (zsh PATH is .zshenv). Kept as a no-op so
# leftover callers cannot write .zshrc. ALIGNMENT: requirement-shell-zshenv.md
path_add_zshrc() {
    return 1
}

# =============================================================================
# path_add_fish() - Add ~/.local/bin to Fish config
# =============================================================================
#
# GENERAL PURPOSE:
# Creates ~/.config/fish directory if needed and appends the PATH setting
# to config.fish only if not already present.
#
# Returns 0 if added (or was already present), 1 if failed.
#
# PRINTF EXCEPTION (class C – file I/O redirect):
# printf … >> "$fish_config" writes shell config content to a file, not
# product stdout/stderr. User-visible “→ Added …” lines use out_plain.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Last reviewed: 2026-07-12
# =============================================================================

path_add_fish() {
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FISH_CONFIG:=${HOME}/.config/fish/config.fish}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=0}"
    : "${JSON:=0}"
    local fish_config="${FISH_CONFIG}"
    local path_line
    local comment
    local fish_dir
    path_line=$(printf 'set -gx PATH %s $PATH' "${USER_BIN}")
    comment=$(printf '# Added by %s installer (%s)' "${APP_NAME}" "${VERSION}")
    fish_dir=$(dirname "${fish_config}")

    if [ ! -d "${fish_dir}" ] && ! mkdir -p "${fish_dir}" 2>/dev/null; then
        return 1
    fi

    if [ -f "$fish_config" ] && grep -qF "${path_line}" "$fish_config" 2>/dev/null; then
        if ! grep -qF "${comment}" "$fish_config" 2>/dev/null; then
            printf "\n%s\n" "${comment}" >> "$fish_config"
            return 0
        fi
        return 1
    fi

    printf "\n%s\n" "${comment}" >> "$fish_config"
    printf '%s\n' "${path_line}" >> "$fish_config"

    if [ "${JSON}" -eq 0 ]; then
        out_plain "→ Added ${USER_BIN} to PATH for fish shell"
    fi
    return 0
}

# =============================================================================
# path_add_shell() - Main orchestrator: Add USER_BIN to shell PATHs
# =============================================================================
#
# GENERAL PURPOSE:
# Adds ${USER_BIN} (default ${HOME}/.local/bin) to bash, zsh, and fish
# configuration files if not already present. Thin orchestrator for path_add_*.
#
# Respects --json mode (silent in JSON).
#
# Last reviewed: 29 April 2026
# =============================================================================

path_add_shell() {
    local added=0
    local shell_config="N/A"
    : "${HOME:=/tmp}"
    : "${BASHRC:=${HOME}/.bashrc}"
    : "${ZSHRC:=${HOME}/.zshrc}"
    : "${FISH_CONFIG:=${HOME}/.config/fish/config.fish}"
    : "${JSON:=0}"

    if path_add_bashrc; then
        added=1
        shell_config="${BASHRC}"
    fi

    # Do not default ZSHENV here: path_add_zshenv treats a set ZSHENV as
    # "zsh environment" (tests). Bash-only with no override must not invent.
    if path_add_zshenv; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${ZSHENV:-${HOME}/.zshenv}"
        else
            shell_config="${shell_config} ${ZSHENV:-${HOME}/.zshenv}"
        fi
    fi

    if path_add_fish; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${FISH_CONFIG}"
        else
            shell_config="${shell_config} ${FISH_CONFIG}"
        fi
    fi

    # Missing .profile: generate the login note for bash/zsh/fish.
    # Alpine ash: that same create also adds USER_BIN, or an existing
    # file is modified to add it. One call owns both.
    if path_ensure_profile; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${PROFILE:-${HOME}/.profile}"
        else
            shell_config="${shell_config} ${PROFILE:-${HOME}/.profile}"
        fi
    fi

    if [ "$added" -eq 1 ] && [ "${JSON}" -eq 0 ]; then
        out_plain "→ Restart your terminal or run: source ${shell_config}"
    fi
}

# =============================================================================
# path_ensure_profile() - Missing .profile: generate; ash also adds PATH
# =============================================================================
#
# GENERAL PURPOSE:
# One missing-file step for every shell.
#   bash / zsh / fish (not ash): generate ~/.profile that sources ~/.bashrc.
#   ash / Alpine: generate that same file, then add USER_BIN to PATH in it.
# An existing file is never replaced. Ash modifies it by appending the PATH
# line when that line is absent.
#
# ALIGNMENT: requirement-shell-path-and-shell-support.md
#             requirement-shell-alpine.md
# Last reviewed: 2026-09-22
# =============================================================================
path_ensure_profile() {
    : "${HOME:=/tmp}"
    : "${PROFILE:=${HOME}/.profile}"
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    local profile="${PROFILE}"

    if [ -f "$profile" ]; then
        path_add_profile_ash
        return $?
    fi

    if ! {
        printf '# BEGIN %s profile source-bashrc\n' "$APP_NAME"
        printf '# Created so a bash login shell sources interactive rc.\n'
        printf 'if [ -n "${BASH_VERSION:-}" ]; then\n'
        printf '    if [ -f "${HOME}/.bashrc" ]; then\n'
        printf '        . "${HOME}/.bashrc"\n'
        printf '    fi\n'
        printf 'fi\n'
        printf '# END %s profile source-bashrc\n' "$APP_NAME"
    } > "$profile"; then
        if [ "${JSON}" -eq 0 ]; then
            out_warn "Could not create ${profile}. Next: create that file as this login so SSH login reads ~/.bashrc, then re-run ${APP_NAME} install."
        fi
        return 1
    fi
    chmod 0644 "$profile" 2>/dev/null || true
    if path_invoking_is_ash; then
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Created ${profile}"
        fi
        path_add_profile_ash
        return $?
    fi
    if [ "${JSON}" -eq 0 ]; then
        out_plain "→ Created ${profile} (login shell sources ~/.bashrc)"
    fi
    return 0
}

# =============================================================================
# path_invoking_is_ash() - Class B: this run is ash (including Alpine sh)
# =============================================================================
#
# GENERAL PURPOSE:
# True when the invoking command name is ash. Login ash sets $0 to -ash.
# Alpine curl|sh sets $0 to sh while /bin/sh is ash; that case is ash when
# /etc/alpine-release exists (tests may point GROK_CLI_ALPINE_RELEASE).
#
# ALIGNMENT: requirement-shell-alpine.md
# Last updated: 2026-09-22
# =============================================================================
path_invoking_is_ash() {
    _pia_raw="${GROK_CLI_ARGV0:-$0}"
    _pia_base=$(basename -- "${_pia_raw}" 2>/dev/null || printf '%s' "${_pia_raw}")
    _pia_base=${_pia_base#-}
    case "${_pia_base}" in
        ash)
            unset _pia_raw _pia_base
            return 0
            ;;
    esac
    case "${_pia_base}" in
        sh)
            if [ -n "${GROK_CLI_ALPINE_RELEASE+x}" ]; then
                _pia_rel="${GROK_CLI_ALPINE_RELEASE}"
            else
                _pia_rel="/etc/alpine-release"
            fi
            if [ -n "${_pia_rel}" ] && [ -f "${_pia_rel}" ]; then
                unset _pia_raw _pia_base _pia_rel
                return 0
            fi
            unset _pia_rel
            ;;
    esac
    unset _pia_raw _pia_base
    return 1
}

# =============================================================================
# path_add_profile_ash() - ash login: PATH export on ~/.profile
# =============================================================================
#
# GENERAL PURPOSE:
# When this run is ash and ~/.profile already exists, append the shared
# USER_BIN export. Does not create the file (path_ensure_profile generates
# a missing .profile first). Does not replace the bash source-bashrc block.
# A non-ash run does not write that export.
#
# ALIGNMENT: requirement-shell-alpine.md
# Last updated: 2026-09-22
# =============================================================================
path_add_profile_ash() {
    if ! path_invoking_is_ash; then
        return 1
    fi
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${PROFILE:=${HOME}/.profile}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=0}"
    : "${JSON:=0}"
    _paa_profile="${PROFILE}"
    _paa_path=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")
    _paa_comment=$(printf '# Added by %s installer (%s)' "${APP_NAME}" "${VERSION}")
    if [ ! -f "${_paa_profile}" ]; then
        unset _paa_profile _paa_path _paa_comment
        return 1
    fi

    if ! grep -qF "${_paa_path}" "${_paa_profile}" 2>/dev/null; then
        printf '\n%s\n' "${_paa_comment}" >> "${_paa_profile}"
        printf '%s\n' "${_paa_path}" >> "${_paa_profile}"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Added ${USER_BIN} to PATH for ash (.profile)"
        fi
        unset _paa_profile _paa_path _paa_comment
        return 0
    fi
    if ! grep -qF "${_paa_comment}" "${_paa_profile}" 2>/dev/null; then
        printf '\n%s\n' "${_paa_comment}" >> "${_paa_profile}"
        if [ "${JSON}" -eq 0 ]; then
            out_plain "→ Noted ${APP_NAME} installer on ash PATH"
        fi
        unset _paa_profile _paa_path _paa_comment
        return 0
    fi
    unset _paa_profile _paa_path _paa_comment
    return 1
}

# =============================================================================
# path_rc_test() - Type 0 test-purpose: create/modify/no-op against --root
# =============================================================================
#
# ALIGNMENT: requirement-shell-path-and-shell-support.md · requirement-shell-zshenv.md
# MUST NOT write this login's real ~/.bashrc or ~/.zshenv. Keep real HOME.
# Last reviewed: 2026-09-17
# =============================================================================
path_rc_test() {
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${APP_NAME:=grok-cli}"
    _prt_root=""
    _prt_file="bashrc"
    _prt_case="create"
    _prt_feature=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --root)
                [ $# -ge 2 ] || out_die "rc-test --root requires a folder. Next: ${APP_NAME} rc-test --root \"\$tmpdir\" --file bashrc --case create"
                _prt_root="$2"
                shift
                ;;
            --file)
                [ $# -ge 2 ] || out_die "rc-test --file requires bashrc|zshenv|profile|ash. Next: ${APP_NAME} rc-test --root \"\$tmpdir\" --file ash --case create"
                _prt_file="$2"
                shift
                ;;
            --case)
                [ $# -ge 2 ] || out_die "rc-test --case requires create|modify|noop"
                _prt_case="$2"
                shift
                ;;
            --feature)
                [ $# -ge 2 ] || out_die "rc-test --feature requires path-ensure|profile-ensure"
                _prt_feature="$2"
                shift
                ;;
            *)
                out_die "Unknown rc-test argument: $1. Next: ${APP_NAME} rc-test --root \"\$tmpdir\" --file bashrc --case create"
                ;;
        esac
        shift
    done
    if [ -z "${_prt_root}" ]; then
        out_die "rc-test requires --root a tmp/cache folder. Next: ${APP_NAME} rc-test --root \"\$tmpdir\" --file bashrc --case create"
    fi
    case "${_prt_file}" in
        bashrc|zshenv|profile|fish|ash) ;;
        zshrc)
            out_die "rc-test zshrc is not claimed (zsh PATH is .zshenv). Next: ${APP_NAME} rc-test --root \"\$tmpdir\" --file zshenv --case create"
            ;;
        *) out_die "rc-test --file must be bashrc, zshenv, profile, ash, or fish" ;;
    esac
    case "${_prt_case}" in
        create|modify|noop) ;;
        *) out_die "rc-test --case must be create, modify, or noop" ;;
    esac
    if ! mkdir -p "${_prt_root}" 2>/dev/null; then
        out_die "rc-test cannot create --root ${_prt_root}"
    fi

    _prt_home_bashrc="${HOME}/.bashrc"
    _prt_home_profile="${HOME}/.profile"
    _prt_home_zshenv="${HOME}/.zshenv"
    _prt_snap_b=""
    _prt_snap_p=""
    _prt_snap_z=""
    [ -f "${_prt_home_bashrc}" ] && _prt_snap_b=$(cat "${_prt_home_bashrc}" 2>/dev/null || true)
    [ -f "${_prt_home_profile}" ] && _prt_snap_p=$(cat "${_prt_home_profile}" 2>/dev/null || true)
    [ -f "${_prt_home_zshenv}" ] && _prt_snap_z=$(cat "${_prt_home_zshenv}" 2>/dev/null || true)

    : "${USER_BIN:=${HOME}/.local/bin}"
    _prt_path=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")
    _prt_comment=$(printf '# Added by %s installer (%s)' "${APP_NAME}" "${VERSION}")

    BASHRC="${_prt_root}/.bashrc"
    ZSHENV="${_prt_root}/.zshenv"
    ZSHRC="${_prt_root}/.zshrc"
    PROFILE="${_prt_root}/.profile"
    FISH_CONFIG="${_prt_root}/config.fish"
    export BASHRC ZSHENV ZSHRC PROFILE FISH_CONFIG

    case "${_prt_file}" in
        bashrc)
            case "${_prt_case}" in
                create) rm -f "${BASHRC}" ;;
                modify)
                    printf '%s\n' "# dongle-bashrc-keep" "alias dongle_probe=true" > "${BASHRC}"
                    ;;
                noop)
                    {
                        printf '%s\n' "# dongle-already-good"
                        printf '%s\n' "${_prt_comment}"
                        printf '%s\n' "${_prt_path}"
                    } > "${BASHRC}"
                    ;;
            esac
            path_add_bashrc || true
            ;;
        zshenv)
            case "${_prt_case}" in
                create) rm -f "${ZSHENV}" ;;
                modify)
                    printf '%s\n' "# dongle-zshenv-keep" > "${ZSHENV}"
                    ;;
                noop)
                    {
                        printf '%s\n' "# dongle-already-good"
                        printf '%s\n' "${_prt_comment}"
                        printf '%s\n' "${_prt_path}"
                    } > "${ZSHENV}"
                    ;;
            esac
            path_add_zshenv || true
            ;;
        profile)
            case "${_prt_case}" in
                create) rm -f "${PROFILE}" ;;
                modify|noop)
                    printf '%s\n' "# keep-existing-profile" > "${PROFILE}"
                    ;;
            esac
            path_ensure_profile || true
            ;;
        ash)
            case "${_prt_case}" in
                create) rm -f "${PROFILE}" ;;
                modify)
                    printf '%s\n' "# keep-existing-profile" > "${PROFILE}"
                    ;;
                noop)
                    {
                        printf '%s\n' "# keep-existing-profile"
                        printf '%s\n' "${_prt_comment}"
                        printf '%s\n' "${_prt_path}"
                    } > "${PROFILE}"
                    ;;
            esac
            GROK_CLI_ARGV0=ash
            export GROK_CLI_ARGV0
            path_ensure_profile || true
            path_add_profile_ash || true
            unset GROK_CLI_ARGV0
            ;;
        fish)
            case "${_prt_case}" in
                create) rm -f "${FISH_CONFIG}" ;;
                modify)
                    mkdir -p "$(dirname "${FISH_CONFIG}")"
                    printf '%s\n' "# dongle-fish-keep" > "${FISH_CONFIG}"
                    ;;
                noop)
                    mkdir -p "$(dirname "${FISH_CONFIG}")"
                    {
                        printf '%s\n' "${_prt_comment}"
                        printf 'set -gx PATH %s $PATH\n' "${USER_BIN}"
                    } > "${FISH_CONFIG}"
                    ;;
            esac
            path_add_fish || true
            ;;
    esac

    _prt_now_b=""
    _prt_now_p=""
    _prt_now_z=""
    [ -f "${_prt_home_bashrc}" ] && _prt_now_b=$(cat "${_prt_home_bashrc}" 2>/dev/null || true)
    [ -f "${_prt_home_profile}" ] && _prt_now_p=$(cat "${_prt_home_profile}" 2>/dev/null || true)
    [ -f "${_prt_home_zshenv}" ] && _prt_now_z=$(cat "${_prt_home_zshenv}" 2>/dev/null || true)
    if [ "${_prt_now_b}" != "${_prt_snap_b}" ] || [ "${_prt_now_p}" != "${_prt_snap_p}" ] || [ "${_prt_now_z}" != "${_prt_snap_z}" ]; then
        out_die "rc-test wrote this login's real home rc. Fixture --root only."
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "rc-test" "ok" \
            "root" "${_prt_root}" \
            "file" "${_prt_file}" \
            "case" "${_prt_case}" \
            "status" "ok"
        return 0
    fi
    out_success "rc-test ${_prt_file} ${_prt_case} under ${_prt_root}"
    return 0
}

# =============================================================================
# inst_ensure_companion() - User-bin PATH + profile (install companion)
# =============================================================================
#
# ALIGNMENT: requirement-shell-path-and-shell-support.md · requirement-shell-zshenv.md
# Runs even when the CLI binary is already installed.
# Last reviewed: 2026-09-17
